{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": ">=22",
        "pnpm": ">=11"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.js\" \"resources/css/**/*.css\" \"vite.config.js\" \"lighthouserc.cjs\" \"public/theme-boot.js\"",
        "format:check": "prettier --check \"resources/js/**/*.js\" \"resources/css/**/*.css\" \"vite.config.js\" \"lighthouserc.cjs\" \"public/theme-boot.js\"",
        "lint": "pnpm run format:check",
        "audit": "pnpm audit --prod",
        "lighthouse": "lhci autorun"
    },
    "devDependencies": {
        "@lhci/cli": "^0.15.1",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^9.2.4",
        "laravel-vite-plugin": "^3.1.3",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.0"
    },
    "dependencies": {
        "@fontsource-variable/outfit": "^5.3.0"
    }
}

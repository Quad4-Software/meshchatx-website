---
import { NAV_LINKS, LOCALES, LOCALE_NAMES, type Locale } from '../config/site';
import { t, localePath } from '../i18n';
import DonateBanner from './DonateBanner.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname.replace(/^\/(de|es|fi|fr|it|nl|ru|zh)(?=\/|$)/, '');
---

<header class="mcx-header">
  <div class="mcx-header-blur"></div>
  <nav class="mcx-header-nav" aria-label={t(locale, 'nav.primary')}>
    <a href={localePath(locale)} class="flex items-center gap-2.5 text-fg">
      <img src="/media/branding/logo/logo-128.webp" alt="" width="30" height="30" class="h-[30px] w-[30px]" />
      <span class="text-lg font-semibold tracking-tight">MeshChatX</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {NAV_LINKS.map((l) => (
        <a
          href={localePath(locale, l.path)}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm transition-colors',
            currentPath.startsWith(`/${l.path}`) ? 'text-fg' : 'text-muted hover:text-fg',
          ]}
        >
          {t(locale, l.key)}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a
        href={localePath(locale, 'donate')}
        class:list={[
          'rounded-md p-1.5 transition-colors',
          currentPath.startsWith('/donate') ? 'text-fg' : 'text-muted hover:text-fg',
        ]}
        aria-label={t(locale, 'nav.donate')}
        title={t(locale, 'nav.donate')}
      >
        <Icon name="mdiPiggyBank" size={18} />
      </a>

      <button
        id="mcx-theme-toggle"
        type="button"
        class="rounded-md px-1.5 py-1.5 text-muted transition-colors hover:text-fg"
        aria-label={t(locale, 'nav.toggle_theme')}
        title={t(locale, 'nav.toggle_theme')}
      >
        <svg class="theme-icon-dark h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="theme-icon-light hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>

      <div class="mcx-flyout">
        <button
          id="mcx-lang-btn"
          type="button"
          class="inline-flex items-center gap-1 rounded-md px-1.5 py-1.5 text-xs font-medium text-muted transition-colors hover:text-fg"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          {locale.toUpperCase()}
          <svg class="lang-chevron h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          <span class="sr-only"> {t(locale, 'lang.pick')}</span>
        </button>
        <div id="mcx-lang-menu" class="mcx-flyout-panel mcx-flyout-end" role="listbox">
          <span class="dropdown-caret pointer-events-none absolute right-3.5 top-1.5 z-10 h-2 w-2 rotate-45 border-l border-t border-line bg-surface" aria-hidden="true"></span>
          <div class="min-w-36 rounded-lg border border-line bg-surface p-1 shadow-xl">
            {LOCALES.map((l) => (
              <a
                href={localePath(l, currentPath.replace(/^\//, ''))}
                role="option"
                aria-selected={l === locale}
                class:list={[
                  'block rounded-md px-3 py-1.5 text-sm',
                  l === locale ? 'bg-raised text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                {LOCALE_NAMES[l]}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href={localePath(locale, 'download')}
        class="hidden rounded-md bg-accent px-3.5 py-1.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-85 sm:inline-block"
      >
        {t(locale, 'nav.download')}
      </a>

      <div class="mcx-flyout md:hidden">
        <button
          id="mcx-mobile-btn"
          type="button"
          class="rounded-md border border-line bg-surface p-1.5 text-muted"
          aria-label={t(locale, 'nav.mobile_menu')}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <div id="mcx-mobile-menu" class="mcx-flyout-panel mcx-flyout-end">
          <div class="min-w-48 rounded-lg border border-line bg-surface p-1 shadow-xl">
            {NAV_LINKS.map((l) => (
              <a href={localePath(locale, l.path)} class="block rounded-md px-3 py-2 text-sm text-muted hover:bg-raised hover:text-fg">
                {t(locale, l.key)}
              </a>
            ))}
            <a href={localePath(locale, 'interfaces')} class="block rounded-md px-3 py-2 text-sm text-muted hover:bg-raised hover:text-fg">{t(locale, 'nav.interfaces')}</a>
            <a href={localePath(locale, 'donate')} class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-muted hover:bg-raised hover:text-fg">
              <Icon name="mdiPiggyBank" size={16} />
              {t(locale, 'nav.donate')}
            </a>
            <a href={localePath(locale, 'download')} class="mt-1 block rounded-md bg-accent px-3 py-2 text-sm font-semibold text-on-accent">{t(locale, 'nav.download')}</a>
          </div>
        </div>
      </div>
    </div>
  </nav>
  {!currentPath.startsWith('/donate') && <DonateBanner locale={locale} />}
</header>

<script>
  const themeBtn = document.getElementById('mcx-theme-toggle');

  const applyThemeIcons = () => {
    const dark = document.documentElement.dataset.theme !== 'light';
    document.querySelectorAll('.theme-icon-dark').forEach((el) => el.classList.toggle('hidden', !dark));
    document.querySelectorAll('.theme-icon-light').forEach((el) => el.classList.toggle('hidden', dark));
  };
  applyThemeIcons();

  const applyThemeImgs = () => {
    const light = document.documentElement.dataset.theme === 'light';
    document.querySelectorAll('img[data-theme-dark][data-theme-light]').forEach((node) => {
      const img = node as HTMLImageElement;
      const src = light ? img.dataset.themeLight : img.dataset.themeDark;
      const ss = light ? img.dataset.srcsetLight : img.dataset.srcsetDark;
      if (src && img.getAttribute('src') !== src) img.src = src;
      if (ss) img.srcset = ss;
      const source = img.parentElement?.querySelector('source');
      if (source) source.media = light ? 'all' : 'not all';
    });
  };
  const osLight = matchMedia('(prefers-color-scheme: light)').matches;
  if ((document.documentElement.dataset.theme === 'light') !== osLight) applyThemeImgs();

  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('mcx-theme', next);
    } catch {}
    applyThemeIcons();
    applyThemeImgs();
  });

  document.querySelectorAll('.mcx-flyout').forEach((box) => {
    const btn = box.querySelector('button');
    const sync = () => {
      const open = box.matches(':hover, :focus-within, .is-open');
      btn?.setAttribute('aria-expanded', String(open));
    };
    box.addEventListener('mouseenter', sync);
    box.addEventListener('mouseleave', () => {
      box.classList.remove('is-open');
      sync();
    });
    box.addEventListener('focusin', sync);
    box.addEventListener('focusout', sync);
    btn?.addEventListener('click', (ev) => {
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      ev.preventDefault();
      box.classList.toggle('is-open');
      sync();
    });
  });
</script>

<style is:global>
  .mcx-header {
    position: sticky;
    top: 0;
    z-index: 200;
    overflow: visible;
    isolation: isolate;
  }
  .mcx-flyout {
    position: relative;
  }
  .mcx-flyout-panel {
    position: absolute;
    top: 100%;
    z-index: 300;
    display: none;
    padding-top: 0.5rem;
  }
  .mcx-flyout-end {
    right: 0;
    min-width: 12rem;
  }
  .mcx-flyout-stretch {
    left: 0;
    right: 0;
  }
  .mcx-flyout:hover > .mcx-flyout-panel,
  .mcx-flyout:focus-within > .mcx-flyout-panel,
  .mcx-flyout.is-open > .mcx-flyout-panel {
    display: block;
  }
  .mcx-header-blur {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas-alpha);
    backdrop-filter: blur(12px);
  }
  .mcx-header-nav {
    position: relative;
    z-index: 1;
    display: flex;
    height: 4rem;
    max-width: 72rem;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.25rem;
  }
</style>

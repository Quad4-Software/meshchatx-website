---
import type { Locale } from '../config/site';
import { t, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<p class="mcx-notice-banner" role="note">{t(locale, 'notice.banner')} <a class="mcx-notice-link" href={`${localePath(locale, 'news')}#maintenance-mode`}>{t(locale, 'notice.read_more')}</a></p>

<style is:global>
  .mcx-notice-banner {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0.25rem 1rem;
    border-bottom: 1px solid rgba(245, 158, 11, 0.5);
    background: rgba(245, 158, 11, 0.16);
    color: #fcd34d;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
  }
  html[data-theme='light'] .mcx-notice-banner {
    border-bottom-color: rgba(217, 119, 6, 0.4);
    background: rgba(217, 119, 6, 0.1);
    color: #92400e;
  }
  .mcx-notice-banner .mcx-notice-link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    font-weight: 600;
  }
  .mcx-notice-banner .mcx-notice-link:hover {
    opacity: 0.85;
  }
</style>

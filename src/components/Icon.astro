---
import * as mdi from '@mdi/js';

interface Props {
  name: keyof typeof mdi | string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls = '' } = Astro.props;
const path = (mdi as Record<string, string>)[name] ?? '';
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={cls}
  aria-hidden="true"
  fill="currentColor"
>
  <path d={path}></path>
</svg>

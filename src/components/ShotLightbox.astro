---
import Icon from './Icon.astro';
import type { Locale } from '../config/site';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const captionId = `${id}-caption`;
---

<dialog
  id={id}
  class="mcx-shot-lightbox"
  aria-labelledby={captionId}
  closedby="any"
>
  <div class="mcx-shot-stage">
    <button type="button" class="mcx-shot-nav" data-shot-prev aria-label={t(locale, 'home.preview.prev')}>
      <Icon name="mdiChevronLeft" size={28} />
    </button>
    <img class="mcx-shot-full" alt="" width="2880" height="1800" decoding="async" />
    <button type="button" class="mcx-shot-nav" data-shot-next aria-label={t(locale, 'home.preview.next')}>
      <Icon name="mdiChevronRight" size={28} />
    </button>
    <form method="dialog" class="mcx-shot-dismiss">
      <button type="submit" class="mcx-shot-x" aria-label={t(locale, 'home.preview.close')}>
        <Icon name="mdiClose" size={20} />
      </button>
    </form>
  </div>
  <p id={captionId} class="mcx-shot-caption"></p>
</dialog>

<script>
  const bindRoot = (root: Element) => {
    if (root.hasAttribute('data-shots-bound')) return;
    root.setAttribute('data-shots-bound', '');

    const dlg = root.querySelector<HTMLDialogElement>('.mcx-shot-lightbox');
    const full = dlg?.querySelector<HTMLImageElement>('.mcx-shot-full');
    const caption = dlg?.querySelector<HTMLElement>('.mcx-shot-caption');
    const prevBtn = dlg?.querySelector<HTMLButtonElement>('[data-shot-prev]');
    const nextBtn = dlg?.querySelector<HTMLButtonElement>('[data-shot-next]');
    if (!dlg || !full || !caption || !prevBtn || !nextBtn) return;

    let index = 0;

    const tiles = (): HTMLElement[] => {
      const inPanel = Array.from(
        root.querySelectorAll<HTMLElement>('[data-panel]:not([hidden]) .mcx-shot-open'),
      );
      if (inPanel.length) return inPanel;
      return Array.from(root.querySelectorAll<HTMLElement>('.mcx-shot-open'));
    };

    const apply = (i: number) => {
      const list = tiles();
      if (!list.length) return;
      index = (i + list.length) % list.length;
      const src = list[index]?.querySelector('img');
      if (!src) return;
      const light = document.documentElement.dataset.theme === 'light';
      const darkSrc =
        src.getAttribute('data-full-dark') ||
        src.getAttribute('data-theme-dark') ||
        src.getAttribute('src') ||
        '';
      const lightSrc = src.getAttribute('data-full-light') || src.getAttribute('data-theme-light') || darkSrc;
      full.alt = src.getAttribute('alt') || '';
      full.src = light ? lightSrc : darkSrc;
      full.setAttribute('data-theme-dark', darkSrc);
      full.setAttribute('data-theme-light', lightSrc);
      full.setAttribute('width', src.getAttribute('width') || '');
      full.setAttribute('height', src.getAttribute('height') || '');
      caption.textContent = full.alt;
      const many = list.length > 1;
      prevBtn.hidden = !many;
      nextBtn.hidden = !many;
    };

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const opener = target.closest('.mcx-shot-open');
      if (!(opener instanceof HTMLElement) || !root.contains(opener)) return;
      const list = tiles();
      index = list.indexOf(opener);
      apply(index < 0 ? 0 : index);
      dlg.showModal();
    });

    prevBtn.addEventListener('click', () => apply(index - 1));
    nextBtn.addEventListener('click', () => apply(index + 1));

    dlg.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target === dlg || target.classList.contains('mcx-shot-stage')) {
        dlg.close();
      }
    });

    dlg.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        apply(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        apply(index + 1);
      }
    });
  };

  document.querySelectorAll('[data-shots]').forEach(bindRoot);
</script>

<style is:global>
  .mcx-shot-lightbox {
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--color-canvas) 94%, transparent);
    color: var(--color-fg);
  }
  .mcx-shot-lightbox[open] {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
  }
  .mcx-shot-lightbox::backdrop {
    background: var(--color-canvas);
    opacity: 0.92;
  }
  .mcx-shot-stage {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    min-height: 0;
    align-items: center;
    justify-content: center;
    padding: 3.25rem 4rem 0.75rem;
  }
  .mcx-shot-full {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    box-shadow: 0 24px 80px color-mix(in srgb, var(--color-fg) 12%, transparent);
  }
  .mcx-shot-caption {
    margin: 0;
    padding: 0.5rem 4rem 1.1rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-align: center;
  }
  .mcx-shot-nav,
  .mcx-shot-x {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-fg);
    cursor: pointer;
  }
  .mcx-shot-nav:hover,
  .mcx-shot-x:hover,
  .mcx-shot-nav:focus-visible,
  .mcx-shot-x:focus-visible {
    background: var(--color-raised);
  }
  .mcx-shot-nav:focus-visible,
  .mcx-shot-x:focus-visible {
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }
  .mcx-shot-nav[hidden] {
    display: none;
  }
  .mcx-shot-nav[data-shot-prev] {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .mcx-shot-nav[data-shot-next] {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .mcx-shot-dismiss {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    margin: 0;
  }
  .mcx-shot-open-flow {
    position: relative;
    inset: auto;
    display: block;
    width: 100%;
    height: auto;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .mcx-shot-open-flow picture {
    display: block;
  }
  .mcx-shot-open-flow img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.15s ease;
  }
  .mcx-shot-open-flow:hover img,
  .mcx-shot-open-flow:focus-visible img {
    opacity: 0.92;
  }
  @media (max-width: 720px) {
    .mcx-shot-stage {
      padding: 3.25rem 0.75rem 3.5rem;
    }
    .mcx-shot-caption {
      padding: 0.4rem 0.75rem 1rem;
    }
    .mcx-shot-nav[data-shot-prev],
    .mcx-shot-nav[data-shot-next] {
      top: auto;
      bottom: 0.65rem;
      transform: none;
    }
  }
</style>

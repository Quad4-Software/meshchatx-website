---
import type { Locale } from '../config/site';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<p class="mcx-eol-banner" role="note">{t(locale, 'eol.banner')}</p>

<style is:global>
  .mcx-eol-banner {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0.25rem 1rem;
    border-bottom: 1px solid rgba(239, 68, 68, 0.5);
    background: rgba(239, 68, 68, 0.16);
    color: #fca5a5;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
  }
  html[data-theme='light'] .mcx-eol-banner {
    border-bottom-color: rgba(220, 38, 38, 0.4);
    background: rgba(220, 38, 38, 0.1);
    color: #991b1b;
  }
</style>

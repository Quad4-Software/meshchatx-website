---
// Theme-aware image: dark asset in dark mode, light asset in light mode.
// Both imgs load eagerly when loading="eager" so the theme flip is instant;
// the off-theme copy is display:none which browsers deprioritise on load.
interface Props {
  dark: string;
  light: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  srcsetDark?: string;
  srcsetLight?: string;
  sizes?: string;
}
const { dark, light, alt, class: cls = '', width, height, loading = 'lazy', fetchpriority = 'auto', srcsetDark, srcsetLight, sizes } = Astro.props;
---

<>
  <img src={dark} srcset={srcsetDark} sizes={sizes} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} class:list={[cls, 'theme-img-dark']} />
  <img src={light} srcset={srcsetLight} sizes={sizes} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} class:list={[cls, 'theme-img-light']} />
</>

<style>
  .theme-img-light {
    display: none;
  }
  :global([data-theme='light']) .theme-img-light {
    display: block;
  }
  :global([data-theme='light']) .theme-img-dark {
    display: none;
  }
</style>

---
// One visible asset per theme. Picture picks the OS default so LCP is a real img.
interface Props {
  dark: string;
  light: string;
  alt: string;
  class?: string;
  width?: number | undefined;
  height?: number | undefined;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  srcsetDark?: string | undefined;
  srcsetLight?: string | undefined;
  sizes?: string;
  fullDark?: string;
  fullLight?: string;
}
const {
  dark,
  light,
  alt,
  class: cls = '',
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  srcsetDark,
  srcsetLight,
  sizes,
  fullDark,
  fullLight,
} = Astro.props;
---

<picture>
  <source media="(prefers-color-scheme: light)" srcset={srcsetLight || light} sizes={sizes} />
  <img
    src={dark}
    srcset={srcsetDark}
    sizes={sizes}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class={cls}
    data-theme-dark={dark}
    data-theme-light={light}
    data-srcset-dark={srcsetDark || ''}
    data-srcset-light={srcsetLight || ''}
    data-full-dark={fullDark || dark}
    data-full-light={fullLight || light}
  />
</picture>

---
// Click-to-load live demo over a real app screenshot poster.
import Icon from './Icon.astro';
import ThemeImage from './ThemeImage.astro';
import { SITE } from '../config/site';
import { t } from '../i18n';
import type { Locale } from '../config/site';

interface Props {
  class?: string;
  locale?: Locale;
}
const { class: cls = '', locale = 'en' } = Astro.props;
---

<div class={`mcx-preview group relative overflow-hidden rounded-xl border border-line ${cls}`}>
  <!-- live demo iframe, injected on demand -->
  <div class="mcx-live absolute inset-0 z-20 hidden bg-[#09090b]"></div>

  <!-- click-to-load overlay -->
  <button
    type="button"
    class="mcx-demo-btn absolute inset-0 z-10 flex cursor-pointer flex-col items-center justify-center gap-3 bg-[#09090b]/55 transition-colors hover:bg-[#09090b]/35"
    data-demo-url={SITE.demoUrl}
    aria-label={t(locale, 'home.preview.demo_open')}
  >
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-600 text-white shadow-lg transition-transform group-hover:scale-105">
      <Icon name="mdiPlay" size={24} />
    </span>
    <span class="rounded-md bg-zinc-900/85 px-3 py-1.5 font-mono text-xs text-zinc-200 ring-1 ring-zinc-700">
      {t(locale, 'home.preview.demo_label')}
    </span>
  </button>

  <ThemeImage
    dark="/media/preview-conversation-dark-1120.webp"
    light="/media/preview-conversation-1120.webp"
    srcsetDark="/media/preview-conversation-dark-560.webp 560w, /media/preview-conversation-dark-800.webp 800w, /media/preview-conversation-dark-1120.webp 1120w"
    srcsetLight="/media/preview-conversation-560.webp 560w, /media/preview-conversation-800.webp 800w, /media/preview-conversation-1120.webp 1120w"
    alt="MeshChatX conversation view"
    width={1120}
    height={700}
    loading="lazy"
    class="mcx-poster block h-auto w-full"
  />

  <style>
    .mcx-preview.mcx-live-open .mcx-live {
      position: static;
      height: min(640px, 80vh);
    }
    .mcx-preview.mcx-live-open .mcx-poster,
    .mcx-preview.mcx-live-open .mcx-demo-btn {
      display: none;
    }
  </style>

  <script>
    document.querySelectorAll('.mcx-demo-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-demo-url') || '';
        const wrap = btn.closest('.mcx-preview');
        const holder = wrap?.querySelector('.mcx-live');
        if (!holder || !url) return;
        const frame = document.createElement('iframe');
        frame.src = url;
        frame.title = 'MeshChatX live demo';
        frame.setAttribute('class', 'h-full w-full border-0');
        frame.setAttribute('allow', 'clipboard-read; clipboard-write');
        holder.appendChild(frame);
        holder.classList.remove('hidden');
        wrap?.classList.add('mcx-live-open');
      });
    });
  </script>
</div>

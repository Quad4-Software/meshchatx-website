---
// Mesh hero: MeshChatX at the hub, Reticulum, Columba and Sideband as
// satellites, packets riding dashed links between them.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const nodes = [
  { x: 256, y: 256, img: '/media/branding/icon/icon-256.webp', size: 88 },
  { x: 132, y: 118, img: '/vendor/reticulum-logo-128.webp', size: 62 },
  { x: 392, y: 138, img: '/vendor/columba.svg', size: 66 },
  { x: 268, y: 424, img: '/vendor/sideband-icon-128.webp', size: 62 },
] as const;
const links: [number, number][] = [
  [0, 1],
  [0, 2],
  [0, 3],
  [1, 2],
  [1, 3],
  [2, 3],
];
const n = (i: number) => nodes[i]!;
---

<svg viewBox="0 0 512 512" class={cls} aria-hidden="true" fill="none" role="presentation">
  <!-- dashed mesh links -->
  <g stroke="var(--color-mist-500)" stroke-width="2" stroke-dasharray="8 10" stroke-linecap="round" opacity="0.7">
    {links.map(([a, b]) => (
      <path d={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y}`} />
    ))}
  </g>

  <!-- packets riding the links -->
  <g class="mg-motion" fill="currentColor">
    {links.map(([a, b], i) => (
      <circle r="5">
        <animateMotion
          path={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y} L ${n(a).x} ${n(a).y}`}
          dur={`${3 + i * 0.55}s`}
          begin={`${i * 0.7}s`}
          repeatCount="indefinite"
        />
      </circle>
    ))}
  </g>

  <!-- announce pulse off the hub -->
  <g class="mg-motion" fill="none" stroke="var(--color-mist-400)" stroke-width="1.5">
    <circle cx="256" cy="256" r="48" opacity="0">
      <animate attributeName="r" values="48;110" dur="4s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.4;0" dur="4s" repeatCount="indefinite" />
    </circle>
  </g>

  <!-- project marks -->
  {nodes.map((p) => (
    <image
      href={p.img}
      x={p.x - p.size / 2}
      y={p.y - p.size / 2}
      width={p.size}
      height={p.size}
      preserveAspectRatio="xMidYMid meet"
    />
  ))}
</svg>

<style>
  @media (prefers-reduced-motion: reduce) {
    .mg-motion {
      display: none;
    }
  }
</style>

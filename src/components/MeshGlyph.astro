---
// Reticulum constellation hero: MeshChatX at the hub with the Reticulum
// ecosystem marks as satellites, packets riding dashed links.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

// Node constellation traced from the Reticulum badge (512 viewBox).
// `img` satellites render the real project marks; `dot` nodes stay abstract.
const nodes = [
  { x: 256, y: 250, img: '/media/branding/icon/icon-128.webp', size: 74 },
  { x: 196, y: 96, img: '/vendor/reticulum-logo-128.webp', size: 52 },
  { x: 434, y: 236, img: '/vendor/columba.svg', size: 56 },
  { x: 104, y: 420, img: '/vendor/sideband-icon-128.webp', size: 54 },
  { x: 232, y: 376, dot: 10 },
  { x: 306, y: 398, dot: 8 },
  { x: 342, y: 352, dot: 7 },
  { x: 150, y: 190, dot: 8 },
];
const links: [number, number][] = [
  [0, 1],
  [0, 7],
  [0, 2],
  [0, 3],
  [3, 4],
  [4, 5],
  [5, 6],
  [6, 2],
  [7, 4],
];
const n = (i: number) => nodes[i]!;
---

<svg
  viewBox="0 0 512 512"
  class={cls}
  aria-hidden="true"
  fill="none"
  role="presentation"
>
  <!-- dashed links -->
  <g stroke="var(--color-mist-500)" stroke-width="2.5" stroke-dasharray="10 9" stroke-linecap="round" opacity="0.75">
    {links.map(([a, b]) => (
      <path d={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y}`} />
    ))}
  </g>

  <!-- packets riding the links -->
  <g class="mg-motion" fill="currentColor">
    {[[0, 2], [0, 3], [3, 4], [7, 4], [5, 6], [0, 1]].map(([a, b], i) => (
      <circle r="5.5">
        <animateMotion
          path={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y} L ${n(a).x} ${n(a).y}`}
          dur={`${2.6 + i * 0.7}s`}
          begin={`${i * 0.65}s`}
          repeatCount="indefinite"
        />
      </circle>
    ))}
  </g>

  <!-- announce pulse off the hub -->
  <g class="mg-motion" fill="none" stroke="var(--color-mist-400)" stroke-width="2">
    <circle cx="256" cy="250" r="40" opacity="0">
      <animate attributeName="r" values="40;96" dur="3.8s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.45;0" dur="3.8s" repeatCount="indefinite" />
    </circle>
  </g>

  <!-- logo satellites -->
  {nodes.map((p) =>
    p.img ? (
      <g class="mg-node">
        <circle
          cx={p.x}
          cy={p.y}
          r={p.size / 2 + 7}
          fill="var(--color-surface)"
          stroke="var(--color-line)"
          stroke-width="1.5"
        />
        <image
          href={p.img}
          x={p.x - p.size / 2}
          y={p.y - p.size / 2}
          width={p.size}
          height={p.size}
          preserveAspectRatio="xMidYMid meet"
        />
      </g>
    ) : (
      <circle cx={p.x} cy={p.y} r={p.dot} fill="var(--color-mist-400)" />
    ),
  )}
</svg>

<style>
  .mg-node {
    filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.35));
  }
  [data-theme='light'] .mg-node {
    filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.12));
  }
  @media (prefers-reduced-motion: reduce) {
    .mg-motion {
      display: none;
    }
  }
</style>

---
// Mesh hero: MeshChatX at the hub, Columba, Sideband, a NomadNet node and a
// propagation node as satellites. Envelope packets ride the dashed links with
// staggered, irregular timing.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

// mdi paths: web (globe) for NomadNet browsing, mailbox for prop nodes
const ICON_PATHS = {
  web: 'M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M8,8H5.08C6.03,6.34 7.57,5.06 9.4,4.44C8.8,5.55 8.35,6.75 8,8M5.08,16H8C8.35,17.25 8.8,18.45 9.4,19.56C7.57,18.93 6.03,17.65 5.08,16M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14M12,4.03C12.83,5.23 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.23 12,4.03M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C6.47,2 2,6.5 2,12C2,17.5 6.5,22 12,22C17.5,22 22,17.5 22,12C22,6.5 17.5,2 12,2Z',
  mailbox: 'M20,6H10V12H8V4H14V0H6V6H4C2.9,6 2,6.9 2,8V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,20V8C22,6.9 21.1,6 20,6Z',
} as const;

const nodes: {
  x: number;
  y: number;
  size: number;
  href?: string;
  img?: string;
  icon?: keyof typeof ICON_PATHS;
}[] = [
  { x: 256, y: 256, img: '/media/branding/icon/icon-256.webp', size: 92 },
  { x: 118, y: 128, img: '/vendor/columba.svg', size: 62, href: 'https://columba.network/' },
  { x: 392, y: 118, img: '/vendor/sideband-icon-128.webp', size: 58, href: 'https://github.com/markqvist/sideband' },
  { x: 116, y: 388, icon: 'web', size: 56, href: 'https://nomadnet.network/' },
  { x: 398, y: 386, icon: 'mailbox', size: 56, href: 'https://reticulum.network/' },
];
const links: [number, number][] = [
  [0, 1],
  [0, 2],
  [1, 2],
  [0, 3],
  [0, 4],
  [1, 3],
  [2, 4],
  [3, 4],
];
const n = (i: number) => nodes[i]!;

// mail envelopes only between messaging-capable nodes; web/prop links carry plain dots
const MESSAGING = new Set([0, 1, 2]);

// deterministic pseudo-random packet timing per link, so each run differs
const packets = links.flatMap(([a, b], i) => {
  const mail = MESSAGING.has(a) && MESSAGING.has(b);
  const r = (k: number) => {
    const x = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
    return x - Math.floor(x);
  };
  const count = mail ? 1 + Math.floor(r(0) * 2) : 1;
  return Array.from({ length: count }, (_, k) => ({
    a,
    b,
    mail,
    dur: 2.6 + r(1 + k) * 3.4,
    begin: -(r(2 + k) * 6).toFixed(2),
    scale: 0.5 + r(3 + k) * 0.28,
  }));
});

---

<svg viewBox="0 0 512 512" class={cls} aria-hidden="true" fill="none" role="presentation">
  <!-- dashed mesh links -->
  <g stroke="var(--color-mist-500)" stroke-width="2" stroke-dasharray="8 10" stroke-linecap="round" opacity="0.7">
    {links.map(([a, b]) => (
      <path d={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y}`} />
    ))}
  </g>

  <!-- packets riding the links, irregular speed and spacing -->
  <g class="mg-motion" fill="currentColor">
    {packets.map((p) => (
      <g>
        {p.mail ? (
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4-8 5-8-5V6l8 5 8-5z" transform={`translate(${-12 * p.scale},${-12 * p.scale}) scale(${p.scale})`} />
        ) : (
          <circle r="4" />
        )}
        <animateMotion
          path={`M ${n(p.a).x} ${n(p.a).y} L ${n(p.b).x} ${n(p.b).y} L ${n(p.a).x} ${n(p.a).y}`}
          dur={`${p.dur.toFixed(2)}s`}
          begin={`${p.begin}s`}
          repeatCount="indefinite"
        />
      </g>
    ))}
  </g>

  <!-- announce pulse off the hub -->
  <g class="mg-motion" fill="none" stroke="var(--color-mist-400)" stroke-width="1.5">
    <circle cx="256" cy="256" r="50" opacity="0">
      <animate attributeName="r" values="50;120" dur="4s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.4;0" dur="4s" repeatCount="indefinite" />
    </circle>
  </g>

  <!-- nodes: images for project marks, mdi glyphs for node types -->
  {nodes.map((p) => {
    const body = p.img ? (
      <image
        href={p.img}
        x={p.x - p.size / 2}
        y={p.y - p.size / 2}
        width={p.size}
        height={p.size}
        preserveAspectRatio="xMidYMid meet"
      />
    ) : (
      <path
        d={p.icon ? ICON_PATHS[p.icon] : ''}
        transform={`translate(${p.x - p.size / 2},${p.y - p.size / 2}) scale(${p.size / 24})`}
        fill="var(--color-muted)"
      />
    );
    return p.href ? (
      <a href={p.href} target="_blank" rel="noopener noreferrer" tabindex="-1">{body}</a>
    ) : (
      body
    );
  })}
</svg>

<style>
  @media (prefers-reduced-motion: reduce) {
    .mg-motion {
      display: none;
    }
  }
</style>

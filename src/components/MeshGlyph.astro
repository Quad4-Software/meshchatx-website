---
// Mesh hero: MeshChatX at the hub, Columba and Sideband as satellites.
// LXMF envelope packets ride the dashed links between them.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const nodes = [
  { x: 256, y: 256, img: '/media/branding/icon/icon-256.webp', size: 96, href: undefined as string | undefined },
  { x: 128, y: 140, img: '/vendor/columba.svg', size: 66, href: 'https://columba.network/' },
  { x: 384, y: 140, img: '/vendor/sideband-icon-128.webp', size: 62, href: 'https://github.com/markqvist/sideband' },
] as const;
const links: [number, number][] = [
  [0, 1],
  [0, 2],
  [1, 2],
];
const n = (i: number) => nodes[i]!;
---

<svg viewBox="0 0 512 512" class={cls} aria-hidden="true" fill="none" role="presentation">
  <!-- dashed mesh links -->
  <g stroke="var(--color-mist-500)" stroke-width="2" stroke-dasharray="8 10" stroke-linecap="round" opacity="0.7">
    {links.map(([a, b]) => (
      <path d={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y}`} />
    ))}
  </g>

  <!-- LXMF packets riding the links: envelope glyph, mdiEmailOutline path scaled -->
  <g class="mg-motion" fill="currentColor">
    {links.map(([a, b], i) => (
      <g>
        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4-8 5-8-5V6l8 5 8-5z" transform="translate(-7.2,-7.2) scale(0.6)" />
        <animateMotion
          path={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y} L ${n(a).x} ${n(a).y}`}
          dur={`${3 + i * 0.55}s`}
          begin={`${i * 0.7}s`}
          repeatCount="indefinite"
        />
      </g>
    ))}
  </g>

  <!-- announce pulse off the hub -->
  <g class="mg-motion" fill="none" stroke="var(--color-mist-400)" stroke-width="1.5">
    <circle cx="256" cy="256" r="52" opacity="0">
      <animate attributeName="r" values="52;120" dur="4s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.4;0" dur="4s" repeatCount="indefinite" />
    </circle>
  </g>

  <!-- project marks, each links to its project -->
  {nodes.map((p) =>
    p.href ? (
      <a href={p.href} target="_blank" rel="noopener noreferrer" tabindex="-1">
        <image
          href={p.img}
          x={p.x - p.size / 2}
          y={p.y - p.size / 2}
          width={p.size}
          height={p.size}
          preserveAspectRatio="xMidYMid meet"
        />
      </a>
    ) : (
      <image
        href={p.img}
        x={p.x - p.size / 2}
        y={p.y - p.size / 2}
        width={p.size}
        height={p.size}
        preserveAspectRatio="xMidYMid meet"
      />
    ),
  )}
</svg>

<style>
  @media (prefers-reduced-motion: reduce) {
    .mg-motion {
      display: none;
    }
  }
</style>

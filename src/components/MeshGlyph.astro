---
// Animated Reticulum mark: the RNS badge as a living mesh. Packets ride the
// links between nodes and hubs announce in expanding rings.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

// Node constellation traced from the Reticulum badge (512 viewBox).
const nodes = [
  { x: 256, y: 256, r: 30, hub: true },
  { x: 214, y: 142, r: 12 },
  { x: 190, y: 92, r: 13 },
  { x: 148, y: 196, r: 12 },
  { x: 466, y: 250, r: 18 },
  { x: 104, y: 428, r: 16 },
  { x: 232, y: 376, r: 17 },
  { x: 298, y: 402, r: 14 },
  { x: 338, y: 356, r: 11 },
];
const links = [
  [0, 1],
  [0, 3],
  [1, 2],
  [1, 3],
  [0, 4],
  [0, 5],
  [5, 6],
  [6, 7],
  [7, 8],
  [8, 4],
] as const;
const n = (i: number) => nodes[i]!;
---

<svg
  viewBox="0 0 512 512"
  class={cls}
  aria-hidden="true"
  fill="none"
  role="presentation"
>
  <!-- badge ring -->
  <circle cx="256" cy="256" r="238" stroke="currentColor" stroke-width="14" />
  <circle cx="256" cy="256" r="216" stroke="currentColor" stroke-width="4" opacity="0.55" />

  <!-- constellation links -->
  <g stroke="currentColor" stroke-width="6" stroke-linecap="round" opacity="0.9">
    {links.map(([a, b]) => (
      <path d={`M ${n(a).x} ${n(a).y} L ${n(b).x} ${n(b).y}`} />
    ))}
  </g>

  <!-- packets riding the links -->
  <g class="mg-motion" fill="currentColor">
    {[[0, 4], [0, 5], [5, 6], [1, 3], [6, 7]].map(([a, b], i) => (
      <circle r="7">
        <animateMotion
          path={`M ${n(a!).x} ${n(a!).y} L ${n(b!).x} ${n(b!).y} L ${n(a!).x} ${n(a!).y}`}
          dur={`${2.4 + i * 0.6}s`}
          begin={`${i * 0.8}s`}
          repeatCount="indefinite"
        />
      </circle>
    ))}
  </g>

  <!-- announce rings from hub + right node -->
  <g class="mg-motion" fill="none" stroke="currentColor" stroke-width="3">
    <circle cx="256" cy="256" r="30" opacity="0">
      <animate attributeName="r" values="30;90" dur="3.6s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.5;0" dur="3.6s" repeatCount="indefinite" />
    </circle>
    <circle cx="466" cy="250" r="18" opacity="0">
      <animate attributeName="r" values="18;60" dur="4.4s" begin="1.8s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.45;0" dur="4.4s" begin="1.8s" repeatCount="indefinite" />
    </circle>
    <circle cx="104" cy="428" r="16" opacity="0">
      <animate attributeName="r" values="16;52" dur="5s" begin="0.9s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.4;0" dur="5s" begin="0.9s" repeatCount="indefinite" />
    </circle>
  </g>

  <!-- nodes -->
  <g fill="currentColor">
    {nodes.map((p) => (
      <circle cx={p.x} cy={p.y} r={p.r} />
    ))}
  </g>

  <!-- RNS -->
  <text
    x="278"
    y="272"
    font-family="'Space Mono', ui-monospace, monospace"
    font-size="72"
    font-weight="700"
    letter-spacing="2"
    fill="currentColor"
  >RNS</text>
</svg>

<style>
  @media (prefers-reduced-motion: reduce) {
    .mg-motion {
      display: none;
    }
  }
</style>

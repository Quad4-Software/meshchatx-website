---
interface Props {
  code: string;
  label?: string;
  copyLabel?: string;
}
const { code, label, copyLabel = 'Copy' } = Astro.props;
const id = `cmd-${Math.random().toString(36).slice(2, 10)}`;
---

<div class="overflow-hidden rounded-lg border border-line bg-surface">
  <div class="flex items-center justify-between border-b border-line px-4 py-2">
    <span class="font-mono text-[11px] uppercase tracking-[0.15em] text-faint">{label}</span>
    <button
      type="button"
      class="copy-btn rounded px-2 py-0.5 font-mono text-[11px] text-muted transition-colors hover:text-fg"
      data-copy-target={id}
      data-label={copyLabel}
    >
      {copyLabel}
    </button>
  </div>
  <pre id={id} class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-fg"><code>{code}</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn[data-copy-target]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.copyTarget ?? '');
      const text = target?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const orig = btn.dataset.label ?? 'Copy';
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = orig), 1600);
      } catch {
        btn.textContent = 'Copy failed';
      }
    });
  });
</script>

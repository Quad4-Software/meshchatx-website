---
import { DONATE, type Locale } from '../config/site';
import { t, localePath } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  id="mcx-donate-banner"
  class="mcx-donate-banner"
  role="region"
  aria-label={t(locale, 'donate.banner')}
>
  <p class="mcx-donate-banner-copy">{t(locale, 'donate.banner')}</p>
  <div class="mcx-donate-banner-icons">
    <a
      href={`${localePath(locale, 'donate')}#xmr`}
      class="mcx-donate-banner-icon"
      data-donate-dismiss
      aria-label={t(locale, 'donate.monero')}
      title={t(locale, 'donate.monero')}
    >
      <Icon name="siMonero" size={18} />
    </a>
    <a
      href={DONATE.kofi}
      class="mcx-donate-banner-icon"
      data-donate-dismiss
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t(locale, 'donate.kofi')}
      title={t(locale, 'donate.kofi')}
    >
      <Icon name="siKofi" size={18} />
    </a>
    <a
      href={DONATE.bmac}
      class="mcx-donate-banner-icon"
      data-donate-dismiss
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t(locale, 'donate.bmac')}
      title={t(locale, 'donate.bmac')}
    >
      <Icon name="siBuymeacoffee" size={18} />
    </a>
  </div>
  <button
    type="button"
    class="mcx-donate-banner-close"
    data-donate-dismiss
    aria-label={t(locale, 'donate.banner_dismiss')}
    title={t(locale, 'donate.banner_dismiss')}
  >
    <Icon name="mdiClose" size={16} />
  </button>
</div>

<script>
  const banner = document.getElementById('mcx-donate-banner');
  const dismiss = () => {
    try {
      localStorage.setItem('mcx-donate-banner', String(Date.now()));
    } catch {}
    document.documentElement.dataset.donateBanner = 'hide';
    if (banner instanceof HTMLElement) banner.hidden = true;
  };
  banner?.querySelectorAll('[data-donate-dismiss]').forEach((el) => {
    el.addEventListener('click', dismiss);
  });
  if (document.documentElement.dataset.donateBanner === 'hide' && banner instanceof HTMLElement) {
    banner.hidden = true;
  }
</script>

<style is:global>
  html[data-donate-banner='hide'] .mcx-donate-banner {
    display: none;
  }
  .mcx-donate-banner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    padding: 0.25rem 3rem 0.25rem 1.25rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .mcx-donate-banner-copy {
    margin: 0;
    text-align: center;
  }
  .mcx-donate-banner-icons {
    display: inline-flex;
    align-items: center;
    gap: 0;
  }
  .mcx-donate-banner-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    min-width: 1.5rem;
    min-height: 1.5rem;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }
  .mcx-donate-banner-icon:hover,
  .mcx-donate-banner-icon:focus-visible {
    color: var(--color-fg);
  }
  .mcx-donate-banner-close {
    position: absolute;
    right: 0.35rem;
    top: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--color-faint);
    cursor: pointer;
    transform: translateY(-50%);
  }
  .mcx-donate-banner-close:hover,
  .mcx-donate-banner-close:focus-visible {
    color: var(--color-fg);
  }
</style>

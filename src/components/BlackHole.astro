---
// Black hole hero art. Ported from quad4.io. The element id registers with
// the starfield, which lenses nearby stars into it.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg
  id="mcx-hole"
  viewBox="0 0 640 460"
  class={cls}
  aria-hidden="true"
  fill="none"
  role="presentation"
  style="transform-origin: 50% 50%"
>
  <defs>
    <linearGradient id="mcx-disk" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="currentColor" stop-opacity="0"></stop>
      <stop offset="0.28" stop-color="currentColor" stop-opacity="0.7"></stop>
      <stop offset="0.7" stop-color="currentColor" stop-opacity="0.22"></stop>
      <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="mcx-rim" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.95"></stop>
      <stop offset="0.45" stop-color="currentColor" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="currentColor" stop-opacity="0.12"></stop>
    </linearGradient>
    <filter id="mcx-faint" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3"></feGaussianBlur>
    </filter>
    <clipPath id="mcx-occlude" clipPathUnits="userSpaceOnUse">
      <path
        clip-rule="evenodd"
        d="M -600 -600 H 600 V 600 H -600 Z M 84 0 A 84 84 0 1 0 -84 0 A 84 84 0 1 0 84 0 Z"
      ></path>
      <rect x="-600" y="0" width="1200" height="600"></rect>
    </clipPath>
  </defs>

  <g transform="rotate(-10 320 230)" stroke="currentColor">
    <path d="M 20 230 A 300 82 0 0 1 620 230" stroke="url(#mcx-disk)" stroke-width="16" opacity="0.3"></path>
    <path d="M 20 230 A 300 82 0 0 1 620 230" stroke="url(#mcx-rim)" stroke-width="1.6"></path>
    <path d="M 68 230 A 252 66 0 0 1 572 230" stroke-width="1.2" opacity="0.38" stroke-dasharray="2 7" class="disk-flow"></path>
    <path d="M 170 230 A 150 40 0 0 1 470 230" stroke="url(#mcx-rim)" stroke-width="2.4" opacity="0.7"></path>
    <path d="M 208 230 A 112 29 0 0 1 432 230" stroke-width="1.2" opacity="0.5"></path>
  </g>

  <path d="M 195 222 A 130 80 0 0 1 445 222" stroke="currentColor" stroke-width="2.2" opacity="0.55"></path>
  <path d="M 195 238 A 130 80 0 0 0 445 238" stroke="currentColor" stroke-width="1.5" opacity="0.24"></path>

  <circle cx="320" cy="230" r="84" fill="var(--color-canvas)"></circle>
  <circle cx="320" cy="230" r="89" stroke="currentColor" stroke-width="5" opacity="0.22" filter="url(#mcx-faint)"></circle>
  <circle cx="320" cy="230" r="89" stroke="currentColor" stroke-width="1.6" opacity="0.9"></circle>
  <circle cx="320" cy="230" r="86" stroke="currentColor" stroke-width="0.7" opacity="0.5"></circle>

  <g transform="rotate(-10 320 230)" stroke="currentColor">
    <path d="M 620 230 A 300 82 0 0 1 20 230" stroke="url(#mcx-rim)" stroke-width="1.6" opacity="0.85"></path>
    <path d="M 572 230 A 252 66 0 0 1 68 230" stroke-width="1.1" opacity="0.4" stroke-dasharray="2 7"></path>
    <path d="M 470 230 A 150 40 0 0 1 170 230" stroke="url(#mcx-rim)" stroke-width="2.2" opacity="0.7"></path>
    <circle cx="499" cy="231" r="2" fill="currentColor" stroke="none" opacity="0.8"></circle>
    <circle cx="118" cy="246" r="1.6" fill="currentColor" stroke="none" opacity="0.55"></circle>
    <circle cx="222" cy="297" r="1.4" fill="currentColor" stroke="none" opacity="0.45"></circle>
  </g>

  <g transform="translate(320 230)" class="hole-orbit">
    <g transform="rotate(-10)">
      <g clip-path="url(#mcx-occlude)">
        <g transform="scale(1 0.268)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="16s" repeatCount="indefinite"></animateTransform>
            <circle cx="215" cy="0" r="3" fill="currentColor" stroke="none"></circle>
          </g>
          <g>
            <animateTransform attributeName="transform" type="rotate" from="140" to="500" dur="26s" repeatCount="indefinite"></animateTransform>
            <circle cx="300" cy="0" r="2" fill="currentColor" stroke="none" opacity="0.65"></circle>
          </g>
          <g>
            <animateTransform attributeName="transform" type="rotate" from="260" to="620" dur="38s" repeatCount="indefinite"></animateTransform>
            <circle cx="262" cy="0" r="1.4" fill="currentColor" stroke="none" opacity="0.4"></circle>
          </g>
        </g>
      </g>
    </g>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: reduce) {
    .hole-orbit {
      display: none;
    }
  }
</style>

<script>
  // Subtle pointer gravity on the hole itself.
  const el = document.getElementById('mcx-hole');
  const ok =
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    matchMedia('(pointer: fine)').matches;
  if (el && ok) {
    let x = 0, y = 0, rot = 0, raf = 0;
    let px = 0, py = 0, active = false;
    window.addEventListener(
      'pointermove',
      (e) => {
        px = e.clientX;
        py = e.clientY;
        active = true;
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => {
      active = false;
    });
    const tick = () => {
      raf = 0;
      let tx = 0, ty = 0, tr = 0;
      if (active) {
        const b = el.getBoundingClientRect();
        const hx = b.left + b.width / 2;
        const hy = b.top + b.height / 2;
        const hr = Math.min(b.width, b.height) / 2;
        const dx = px - hx;
        const dy = py - hy;
        const d = Math.hypot(dx, dy);
        const reach = hr * 4;
        if (d > 1 && d < reach) {
          const k = 1 - d / reach;
          const pull = k * k * hr * 0.14;
          tx = (dx / d) * pull;
          ty = (dy / d) * pull;
          tr = Math.max(-2.5, Math.min(2.5, (dx / hr) * 1.4));
        }
      }
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      rot += (tr - rot) * 0.08;
      el.style.transform = `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px) rotate(${rot.toFixed(3)}deg)`;
      if (active || Math.abs(x) > 0.05 || Math.abs(y) > 0.05 || Math.abs(rot) > 0.01) {
        raf = requestAnimationFrame(tick);
      }
    };
  }
</script>

---
import { t } from '../i18n';
import Icon from './Icon.astro';
import type { Locale } from '../config/site';
import type { ReleaseDownloads } from '../lib/releases';

interface Props {
  locale: Locale;
  downloads?: ReleaseDownloads | undefined;
  keys: string[];
  combined?: boolean;
}
const { locale, downloads, keys, combined = false } = Astro.props;

const rows = keys
  .map((key) => ({ key, a: (downloads as Record<string, { name: string; sha256: string | null } | null> | undefined)?.[key] }))
  .filter((r): r is { key: string; a: { name: string; sha256: string } } => !!r.a?.sha256);
const combinedText = rows.map((r) => `${r.a.sha256}  ${r.a.name}`).join('\n');
---

<details
  class:list={['dl-sha256', rows.length === 0 && 'hidden']}
  data-sha256-card
  data-sha-keys={keys.join(',')}
  data-sha-combined={combined || undefined}
>
  <summary>{t(locale, 'dl.sha256')}</summary>
  <div class="dl-sha256-list" data-sha256-list>
    {combined ? (
      <div class="dl-sha256-box">
        <button
          type="button"
          class="hash-copy dl-sha256-copy"
          data-copy={combinedText}
          data-copied={t(locale, 'js.copied')}
          aria-label={t(locale, 'dl.copy_sha256')}
          title={t(locale, 'dl.copy_sha256')}
        >
          <Icon name="mdiContentCopy" size={13} />
        </button>
        <code>{combinedText}</code>
      </div>
    ) : (
      rows.map((r) => (
        <div class="dl-sha256-row" data-sha-key={r.key}>
          <span class="dl-sha256-name">{r.a.name}</span>
          <div class="dl-sha256-box">
            <button
              type="button"
              class="hash-copy dl-sha256-copy"
              data-copy={r.a.sha256}
              data-copied={t(locale, 'js.copied')}
              aria-label={t(locale, 'dl.copy_sha256')}
              title={t(locale, 'dl.copy_sha256')}
            >
              <Icon name="mdiContentCopy" size={13} />
            </button>
            <code>{r.a.sha256}</code>
          </div>
        </div>
      ))
    )}
  </div>
</details>

---
// Fixed starfield canvas. Stars twinkle; nothing else.
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <canvas id="mcx-stars" class="starfield-canvas block h-full w-full text-fg"></canvas>
</div>

<script>
  interface Star {
    x: number;
    y: number;
    r: number;
    a: number;
    sp: number;
    ph: number;
  }

  const STAR_COUNT = matchMedia('(max-width: 720px)').matches ? 90 : 180;
  const cv = document.getElementById('mcx-stars') as HTMLCanvasElement | null;
  const ctx = cv?.getContext('2d');
  const motionOK = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const idle = (window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 1))) as (fn: () => void) => void;

  const init = () => {
    if (!(cv && ctx)) return;
    let w = 0;
    let h = 0;
    let stars: Star[] = [];
    let t = 0;
    let starColor = '#fff';

    const readColor = () => {
      starColor = getComputedStyle(cv).color;
    };
    readColor();
    new MutationObserver(readColor).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    const seed = (): Star => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() < 0.75 ? 1 : 1.6,
      a: 0.25 + Math.random() * 0.6,
      sp: 0.4 + Math.random() * 1.1,
      ph: Math.random() * Math.PI * 2,
    });

    const step = () => {
      t += 0.016;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = starColor;
      for (const s of stars) {
        const tw = 0.65 + 0.35 * Math.sin(t * s.sp + s.ph);
        ctx.globalAlpha = s.a * tw;
        ctx.fillRect(s.x, s.y, s.r, s.r);
      }
      ctx.globalAlpha = 1;
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.25);
      w = cv.clientWidth;
      h = cv.clientHeight;
      cv.width = w * dpr;
      cv.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      stars = Array.from({ length: STAR_COUNT }, seed);
      if (!motionOK) step();
    };
    resize();
    window.addEventListener('resize', resize);

    if (motionOK) {
      let skip = false;
      let raf = 0;
      const loop = () => {
        raf = requestAnimationFrame(loop);
        if (document.hidden) return;
        if ((skip = !skip)) return;
        step();
      };
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
        } else {
          raf = requestAnimationFrame(loop);
        }
      });
      raf = requestAnimationFrame(loop);
    } else {
      t = 1;
      step();
    }
  };
  idle(init);
</script>

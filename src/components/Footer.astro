---
import { FOOTER_GROUPS, SITE, type Locale } from '../config/site';
import { t, localePath } from '../i18n';
import ThemeImage from './ThemeImage.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="border-t border-line bg-canvas">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <img src="/media/branding/logo/logo-128.webp" alt="" width="28" height="28" class="h-7 w-7" />
          <span class="font-semibold tracking-tight">MeshChatX</span>
        </div>
        <p class="mt-3 max-w-xs text-sm text-muted">{t(locale, 'footer.tagline')}</p>
      </div>
      {FOOTER_GROUPS.map((g) => (
        <div>
          <h2 class="mb-3 font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-faint">
            {t(locale, g.group)}
          </h2>
          <ul class="space-y-2">
            {g.links.map((l) => (
              <li>
                <a href={localePath(locale, l.path)} class="text-sm text-muted transition-colors hover:text-fg">
                  {t(locale, l.key)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mcx-footer-meta mt-12 border-t border-line pt-6 text-xs text-faint">
      <span class="mcx-footer-meta-start">{t(locale, 'footer.meta_copyright')}</span>
      <a
        href={SITE.quad4Url}
        class="mcx-footer-credit inline-flex items-center justify-center gap-1.5 transition-colors hover:text-fg"
      >
        <span>{t(locale, 'footer.developed_by')}</span>
        <ThemeImage
          dark="/media/quad4/quad4-mark.svg"
          light="/media/quad4/quad4-mark-black.svg"
          alt=""
          width={20}
          height={20}
          class="h-5 w-5 shrink-0"
        />
      </a>
      <span class="mcx-footer-meta-end">
        <a href={SITE.githubUrl} class="underline decoration-line underline-offset-2 hover:text-fg">{t(locale, 'footer.source')}</a>
        {' \u00b7 '}
        <a href="/legacy" class="underline decoration-line underline-offset-2 hover:text-fg">{t(locale, 'footer.legacy')}</a>
        {' \u00b7 '}
        {t(locale, 'footer.license_badge')}
      </span>
    </div>
  </div>
</footer>

<style>
  .mcx-footer-meta {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .mcx-footer-meta-start,
  .mcx-footer-meta-end {
    text-align: center;
  }
  @media (min-width: 48rem) {
    .mcx-footer-meta {
      grid-template-columns: 1fr auto 1fr;
    }
    .mcx-footer-meta-start {
      text-align: left;
    }
    .mcx-footer-meta-end {
      text-align: right;
    }
  }
</style>

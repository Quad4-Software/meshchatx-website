---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CommandBlock from '../../components/CommandBlock.astro';
import Icon from '../../components/Icon.astro';
import ShaDetails from '../../components/ShaDetails.astro';
import { LOCALES, SITE, type Locale } from '../../config/site';
import { t } from '../../i18n';
import { releasesForChannel, type Channel, type Release } from '../../lib/releases';
import { attachLocalTorrent, loadLocalTorrents } from '../../lib/torrents';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const channels: Channel[] = ['stable', 'beta', 'testing'];
const localTorrents = loadLocalTorrents();

const perChannel = Object.fromEntries(
  await Promise.all(
    channels.map(async (c) => [c, await releasesForChannel(c)]),
  ),
) as Record<Channel, Release[]>;

for (const list of Object.values(perChannel)) {
  for (const rel of list) attachLocalTorrent(rel, localTorrents);
}

// Baked payload for the client: tag -> downloads per channel.
const payload = Object.fromEntries(
  channels.map((c) => [
    c,
    perChannel[c].map((r) => ({
      tag: r.tag,
      version: r.version,
      publishedAt: r.publishedAt,
      releaseUrl: r.releaseUrl,
      downloads: Object.fromEntries(
        Object.entries(r.downloads).map(([k, a]) => [
          k,
          a
            ? {
                name: a.name,
                url: a.url,
                githubUrl: a.githubUrl,
                cdnUrl: a.cdnUrl ?? null,
                magnet: a.magnet ?? null,
                sha256: a.sha256 ?? null,
              }
            : null,
        ]),
      ),
      downloadServer: r.downloadServer,
      downloadServers: r.downloadServers,
    })),
  ]),
);

const flatpakRefName = (c: Channel) =>
  c === 'beta' ? 'meshchatx-beta.flatpakref' : c === 'testing' ? 'meshchatx-testing.flatpakref' : 'meshchatx-stable.flatpakref';

const flatpakCommands = (c: Channel) =>
  `flatpak install --from ${SITE.flatpakCdnBase}/${flatpakRefName(c)}\nflatpak run ${SITE.flatpakAppId}\nflatpak update`;

const flatpakRemote = (c: Channel) =>
  `flatpak remote-add --if-not-exists meshchatx ${SITE.flatpakCdnBase}/meshchatx.flatpakrepo\nflatpak install meshchatx ${SITE.flatpakAppId}//${c}`;

const dl = (key: string, vars: Record<string, string | number> = {}) => t(locale, `dl.${key}`, vars);

const card = 'dl-card rounded-xl border border-line bg-surface p-6';
const btn = 'dl-link inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-85';
const btnGhost = 'dl-link inline-flex items-center justify-center gap-2 rounded-lg border border-line px-4 py-2 text-sm font-medium text-fg transition-colors hover:bg-raised';
const btnMini = 'dl-link inline-flex items-center justify-center rounded-md border border-line px-2 py-1.5 text-xs text-muted transition-colors hover:bg-raised hover:text-fg';
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.download')}
  description={t(locale, 'meta.desc.download')}
  ogCard="card-download"
  path="download"
>
  <PageHero title={dl('h1')} lead={dl('lead')} compact />

  <!-- Channel picker + version selector -->
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-3 px-5">
    <div class="inline-flex rounded-lg border border-line bg-surface p-1" role="tablist">
      {channels.map((c) => (
        <button
          type="button"
          role="tab"
          aria-selected={c === 'stable'}
          aria-controls={`dl-panel-${c}`}
          data-channel={c}
          class:list={[
            'channel-tab rounded-md px-4 py-1.5 text-sm font-medium transition-colors',
            c === 'stable' ? 'bg-raised text-fg' : 'text-muted hover:text-fg',
          ]}
        >
          {t(locale, `js.download.channel_${c}`)}
        </button>
      ))}
    </div>
    <div class="ml-auto flex flex-wrap items-center gap-2">
      <select
        id="dl-version"
        aria-label={t(locale, 'js.download.select_version')}
        class="rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-xs text-muted focus:border-mist-500 focus:outline-none"
      >
      </select>
      <div
        id="dl-source-wrap"
        class="dl-source-notch hidden"
        role="tablist"
        aria-label={t(locale, 'dl.download_server')}
      >
        <button
          type="button"
          role="tab"
          class="dl-source-tab"
          data-source="bunny"
          aria-selected="true"
          tabindex="0"
        >
          <img src="/vendor/bunny-logo-orange.svg" alt="" width="12" height="14" />
          <span>{t(locale, 'dl.download_server_bunny')}</span>
        </button>
        <button
          type="button"
          role="tab"
          class="dl-source-tab"
          data-source="github"
          aria-selected="false"
          tabindex="-1"
        >
          <Icon name="mdiGithub" size={14} />
          <span>{t(locale, 'dl.download_server_github')}</span>
        </button>
      </div>
    </div>
  </div>

  <p id="dl-release-meta" class="mx-auto mt-4 max-w-6xl px-5 font-mono text-xs text-faint"></p>

  <noscript>
    <div class="mx-auto mt-6 max-w-6xl px-5">
      <div class="rounded-xl border border-line bg-surface p-6">
        <h2 class="font-semibold text-fg">{t(locale, 'dl.nojs_banner_title')}</h2>
        <p class="mt-1 text-sm text-muted">{t(locale, 'dl.nojs_banner_text')}</p>
        <a href={SITE.githubReleases} class="mt-3 inline-block text-sm text-fg underline decoration-line underline-offset-4">
          {t(locale, 'dl.github_releases')}
        </a>
      </div>
    </div>
  </noscript>

  {channels.map((c) => {
    const d = perChannel[c][0]?.downloads;
    return (
    <section id={`dl-panel-${c}`} role="tabpanel" data-channel-panel={c} class:list={['mx-auto max-w-6xl px-5 py-10', c !== 'stable' && 'hidden']}>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <!-- Windows -->
        <div id={c === 'stable' ? `dl-win` : undefined} class={card} data-platform="win">
          <div class="flex items-center gap-2">
            <Icon name="mdiMicrosoftWindows" size={20} class="text-muted" />
            <h2 class="font-semibold text-fg">{t(locale, 'dl.windows.h2')}</h2>
            <span class="dl-rec hidden rounded-full border border-fg bg-canvas px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-fg">{t(locale, 'dl.recommended')}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{t(locale, 'dl.windows.friendly')}</p>
          <div class="mt-4 flex flex-col gap-2">
            <a data-asset="winInstaller" href={d?.winInstaller?.url ?? '#'} class:list={[btn, !d?.winInstaller && 'hidden']}>
              <Icon name="mdiDownload" size={15} />
              {t(locale, 'dl.windows.btn_installer')}
            </a>
            <a data-asset="winPortable" href={d?.winPortable?.url ?? '#'} class:list={[btnGhost, !d?.winPortable && 'hidden']}>
              {t(locale, 'dl.windows.btn_portable')}
            </a>
            <span data-asset-none="windows" class:list={['text-sm text-faint', d?.winInstaller && 'hidden']}>{t(locale, 'dl.windows.no_win')}</span>
          </div>
          <ShaDetails locale={locale} downloads={d} keys={['winInstaller', 'winPortable']} />
        </div>

        <!-- macOS -->
        <div id={c === 'stable' ? `dl-mac` : undefined} class={card} data-platform="mac">
          <div class="flex items-center gap-2">
            <Icon name="mdiApple" size={20} class="text-muted" />
            <h2 class="font-semibold text-fg">{t(locale, 'dl.macos.h2')}</h2>
            <span class="dl-rec hidden rounded-full border border-fg bg-canvas px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-fg">{t(locale, 'dl.recommended')}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{t(locale, 'dl.macos.friendly')}</p>
          <div class="mt-4 flex flex-col gap-2">
            <a data-asset="macDmg" href={d?.macDmg?.url ?? '#'} class:list={[btn, !d?.macDmg && 'hidden']}>
              <Icon name="mdiDownload" size={15} />
              {t(locale, 'dl.macos.btn_dmg_arm')}
            </a>
            <a data-asset="macDmgX64" href={d?.macDmgX64?.url ?? '#'} class:list={[btnGhost, !d?.macDmgX64 && 'hidden']}>
              {t(locale, 'dl.macos.btn_dmg_x64')}
            </a>
          </div>
          <ShaDetails locale={locale} downloads={d} keys={['macDmg', 'macDmgX64']} />
        </div>

        <!-- Linux -->
        <div id={c === 'stable' ? `dl-linux` : undefined} class={card} data-platform="linux">
          <div class="flex items-center gap-2">
            <Icon name="mdiLinux" size={20} class="text-muted" />
            <h2 class="font-semibold text-fg">{t(locale, 'dl.linux.h2')}</h2>
            <span class="dl-rec hidden rounded-full border border-fg bg-canvas px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-fg">{t(locale, 'dl.recommended')}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{t(locale, 'dl.linux.friendly')}</p>
          <div class="mt-4 flex flex-col gap-2">
            <a data-asset="appImageAmd64" href={d?.appImageAmd64?.url ?? '#'} class:list={[btn, !d?.appImageAmd64 && 'hidden']}>
              <Icon name="mdiDownload" size={15} />
              {t(locale, 'dl.linux.btn_appimage_amd64')}
            </a>
            <a data-asset="appImageArm64" href={d?.appImageArm64?.url ?? '#'} class:list={[btnGhost, !d?.appImageArm64 && 'hidden']}>
              {t(locale, 'dl.linux.btn_appimage_arm64')}
            </a>
            <div class="grid grid-cols-2 gap-2">
              <a data-asset="debAmd64" href={d?.debAmd64?.url ?? '#'} class:list={[btnMini, 'gap-1.5', !d?.debAmd64 && 'hidden']}><Icon name="siDebian" size={13} />.deb amd64</a>
              <a data-asset="debArm64" href={d?.debArm64?.url ?? '#'} class:list={[btnMini, 'gap-1.5', !d?.debArm64 && 'hidden']}><Icon name="siDebian" size={13} />.deb arm64</a>
              <a data-asset="rpmAmd64" href={d?.rpmAmd64?.url ?? '#'} class:list={[btnMini, 'gap-1.5', !d?.rpmAmd64 && 'hidden']}><Icon name="siFedora" size={13} />.rpm amd64</a>
              <a data-asset="alpineApk" href={d?.alpineApk?.url ?? '#'} class:list={[btnMini, 'gap-1.5', !d?.alpineApk && 'hidden']}><Icon name="siAlpinelinux" size={13} />.apk alpine</a>
            </div>
          </div>
          <ShaDetails locale={locale} downloads={d} keys={['appImageAmd64', 'appImageArm64', 'debAmd64', 'debArm64', 'rpmAmd64', 'alpineApk']} />
        </div>

        <!-- Android -->
        <div id={c === 'stable' ? `dl-android` : undefined} class={card} data-platform="android">
          <div class="flex items-center gap-2">
            <Icon name="mdiAndroid" size={20} class="text-muted" />
            <h2 class="font-semibold text-fg">{t(locale, 'dl.android.h2')}</h2>
            <span class="dl-rec hidden rounded-full border border-fg bg-canvas px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-fg">{t(locale, 'dl.recommended')}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{t(locale, 'dl.android.friendly')}</p>
          <div class="mt-4 flex flex-col gap-2">
            <a data-asset="apk" href={d?.apk?.url ?? '#'} class:list={[btn, !d?.apk && 'hidden']}>
              <Icon name="mdiDownload" size={15} />
              {t(locale, 'dl.android.btn_apk')}
            </a>
            <a href={SITE.obtainiumUrl} target="_blank" rel="noopener noreferrer" aria-label={t(locale, 'dl.android.obtainium_alt')} class="inline-flex items-center">
              <img src="/vendor/obtainium-badge.webp" alt={t(locale, 'dl.android.obtainium_alt')} width="564" height="168" class="h-9 w-auto rounded" />
            </a>
            <div class="rounded-lg border border-line bg-canvas p-3">
              <p class="font-mono text-[10px] uppercase tracking-wider text-faint">{t(locale, 'dl.android.appverifier')}</p>
              <p class="mt-1 text-xs leading-relaxed text-muted">{t(locale, 'dl.android.appverifier_lead')}</p>
              <p class="mt-2 font-mono text-[11px] text-muted">{SITE.androidPackage}</p>
              <p class="mt-1 break-all font-mono text-[11px] leading-relaxed text-fg">{SITE.androidCertSha256}</p>
              <button
                type="button"
                class="hash-copy mt-2 inline-flex items-center rounded-md border border-line px-2.5 py-1 font-mono text-[11px] text-muted transition-colors hover:text-fg"
                data-copy={`${SITE.androidPackage}\n${SITE.androidCertSha256}`}
                data-copied={t(locale, 'js.copied')}
              >
                {t(locale, 'dl.android.copy_appverifier')}
              </button>
            </div>
          </div>
          <ShaDetails locale={locale} downloads={d} keys={['apk']} />
        </div>

        <!-- Arch Linux -->
        <div id={c === 'stable' ? `dl-arch` : undefined} class={card} data-platform="arch">
          <div class="flex items-center gap-2">
            <Icon name="siArchlinux" size={20} class="text-muted" />
            <h2 class="font-semibold text-fg">{t(locale, 'dl.archlinux.h2')}</h2>
          </div>
          <p class="mt-1 text-sm text-muted">{t(locale, 'dl.archlinux.intro')}</p>
          <div class="arch-warn mt-4 flex gap-2 rounded-lg border p-3">
            <Icon name="mdiAlertOutline" size={16} class="mt-0.5 shrink-0" />
            <p class="text-xs leading-relaxed">{t(locale, 'dl.archlinux.warn')}</p>
          </div>
          <a
            href={SITE.archUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[btn, 'mt-4']}
          >
            {t(locale, 'dl.archlinux.btn')}
          </a>
        </div>

        <!-- Python -->
        <div id={c === 'stable' ? `dl-python` : undefined} class={card} data-platform="python">
          <div class="flex items-center gap-2">
            <Icon name="mdiLanguagePython" size={20} class="text-muted" />
            <h2 class="font-semibold text-fg">{t(locale, 'dl.python.h2')}</h2>
          </div>
          <p class="mt-1 text-sm text-muted">{t(locale, 'dl.python.friendly')}</p>

          <div class="mt-4 inline-flex rounded-lg border border-line bg-canvas p-0.5" role="tablist" aria-label={t(locale, 'dl.python.h2')}>
            {['pip', 'pipx', 'uv', 'pyz', 'pip-rns'].map((m, i) => (
              <button
                type="button"
                role="tab"
                aria-selected={i === 0}
                data-pip-tab={m}
                class:list={[
                  'pip-tab rounded-md px-2.5 py-1 text-xs font-medium transition-colors',
                  i === 0 ? 'bg-raised text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                {m === 'pyz' ? '.pyz' : m}
              </button>
            ))}
          </div>

          <div data-pip-panel="pip" class="pip-panel mt-3">
            <CommandBlock label="pip" code={`pip install ${SITE.pypiPackage}`} copyLabel={t(locale, 'dl.python.copy')} />
          </div>
          <div data-pip-panel="pipx" class="pip-panel mt-3 hidden">
            <CommandBlock label="pipx" code={`pipx install ${SITE.pypiPackage}`} copyLabel={t(locale, 'dl.python.copy')} />
          </div>
          <div data-pip-panel="uv" class="pip-panel mt-3 hidden">
            <CommandBlock label="uv" code={`uv tool install ${SITE.pypiPackage}\nuvx ${SITE.pypiPackage.replace('reticulum-', '')}`} copyLabel={t(locale, 'dl.python.copy')} />
          </div>
          <div data-pip-panel="pyz" class="pip-panel mt-3 hidden">
            <div class="grid grid-cols-2 gap-2">
              <a data-asset="pyzPy314X64" href={d?.pyzPy314X64?.url ?? '#'} class:list={[btnMini, !d?.pyzPy314X64 && 'hidden']}>.pyz py3.14 x64</a>
              <a data-asset="pyzPy314Arm64" href={d?.pyzPy314Arm64?.url ?? '#'} class:list={[btnMini, !d?.pyzPy314Arm64 && 'hidden']}>.pyz py3.14 arm64</a>
              <a data-asset="pyzPy311X64" href={d?.pyzPy311X64?.url ?? '#'} class:list={[btnMini, !d?.pyzPy311X64 && 'hidden']}>.pyz py3.11 x64</a>
              <a data-asset="pyzPy311Arm64" href={d?.pyzPy311Arm64?.url ?? '#'} class:list={[btnMini, !d?.pyzPy311Arm64 && 'hidden']}>.pyz py3.11 arm64</a>
            </div>
            <div class="mt-3">
              <CommandBlock label="run" code={`python meshchatx-py314-linux-x64.pyz`} copyLabel={t(locale, 'dl.python.copy')} />
            </div>
          </div>
          <div data-pip-panel="pip-rns" class="pip-panel mt-3 hidden">
            <p class="mb-3 text-xs text-muted">{t(locale, 'dl.python.pip_rns_intro')}</p>
            <a href={SITE.pipRnsUrl} target="_blank" rel="noopener noreferrer" class={btnGhost}>
              pip-rns.quad4.io
            </a>
          </div>

          <a data-asset="wheel" href={d?.wheel?.url ?? '#'} class:list={[btnMini, 'mt-4', !d?.wheel && 'hidden']}>
            {t(locale, 'dl.python.btn_whl')}
          </a>
          <ShaDetails locale={locale} downloads={d} keys={['pyzPy314X64', 'pyzPy314Arm64', 'pyzPy311X64', 'pyzPy311Arm64', 'wheel']} />
        </div>
      </div>

      <!-- Containers -->
      <div id={c === 'stable' ? `dl-containers` : undefined} class={`${card} mt-4`} data-platform="containers">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="font-semibold text-fg">{t(locale, 'dl.containers.h2')}</h2>
          <div
            class="ml-auto inline-flex rounded-lg border border-line bg-canvas p-0.5"
            role="tablist"
            aria-label={t(locale, 'dl.containers.engine_label')}
          >
            <button
              type="button"
              role="tab"
              aria-selected="true"
              data-engine-tab="docker"
              class="engine-tab inline-flex items-center gap-1.5 rounded-md bg-raised px-2.5 py-1 text-xs font-medium text-fg"
            >
              <Icon name="mdiDocker" size={16} />
              {t(locale, 'dl.containers.docker')}
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-engine-tab="podman"
              class="engine-tab inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium text-muted hover:text-fg"
            >
              <Icon name="siPodman" size={16} />
              {t(locale, 'dl.containers.podman')}
            </button>
          </div>
        </div>
        <p class="mt-1 text-sm text-muted">{t(locale, 'dl.containers.friendly')}</p>
        <div data-engine-panel="docker" class="engine-panel mt-5">
          <div class="grid gap-4 lg:grid-cols-2">
            <CommandBlock label="Docker Hub" code={`docker pull ${SITE.dockerHub}`} copyLabel={t(locale, 'dl.python.copy')} />
            <CommandBlock label="GHCR" code={`docker pull ${SITE.ghcr}`} copyLabel={t(locale, 'dl.python.copy')} />
          </div>
        </div>
        <div data-engine-panel="podman" class="engine-panel mt-5 hidden">
          <div class="grid gap-4 lg:grid-cols-2">
            <CommandBlock label="Docker Hub" code={`podman pull ${SITE.dockerHub}`} copyLabel={t(locale, 'dl.python.copy')} />
            <CommandBlock label="GHCR" code={`podman pull ${SITE.ghcr}`} copyLabel={t(locale, 'dl.python.copy')} />
          </div>
        </div>
      </div>

      <!-- Torrent -->
      <div id={c === 'stable' ? `dl-torrent` : undefined} class:list={[card, 'mt-4', !d?.torrent && 'hidden']} data-platform="torrent">
        <div class="flex items-center gap-2">
          <Icon name="mdiDownloadNetwork" size={20} class="text-muted" />
          <h2 class="font-semibold text-fg">{t(locale, 'dl.torrent.h2')}</h2>
        </div>
        <p class="mt-1 text-sm text-muted">{t(locale, 'dl.torrent.intro')}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a data-asset="torrent" href={d?.torrent?.url ?? '#'} class:list={[btn, !d?.torrent && 'hidden']}>
            <Icon name="mdiDownload" size={15} />
            {t(locale, 'dl.torrent.btn')}
          </a>
          <button
            type="button"
            class:list={[
              'hash-copy inline-flex items-center justify-center gap-2 rounded-lg border border-line px-4 py-2 text-sm font-medium text-fg transition-colors hover:bg-raised',
              !d?.torrent?.magnet && 'hidden',
            ]}
            data-magnet-from="torrent"
            data-copy={d?.torrent?.magnet ?? ''}
            data-copied={t(locale, 'js.copied')}
          >
            {t(locale, 'dl.torrent.magnet')}
          </button>
        </div>
        <p class="mt-3 flex items-start gap-1.5 text-xs text-warn">
          <Icon name="mdiShieldAlertOutline" size={14} class="mt-px shrink-0" />
          {t(locale, 'dl.torrent.privacy')}
        </p>
        <ShaDetails
          locale={locale}
          downloads={d}
          combined
          keys={['winInstaller', 'winPortable', 'macDmg', 'macDmgX64', 'apk', 'alpineApk', 'flatpak', 'appImageAmd64', 'appImageArm64', 'debAmd64', 'debArm64', 'rpmAmd64', 'pyzPy314X64', 'pyzPy314Arm64', 'pyzPy311X64', 'pyzPy311Arm64', 'wheel', 'torrent']}
        />
      </div>

      <!-- Flatpak -->
      <div id={c === 'stable' ? `dl-flatpak` : undefined} class={`${card} mt-4`} data-platform="flatpak">
        <div class="flex items-center gap-2">
          <Icon name="siFlatpak" size={20} class="text-muted" />
          <h2 class="font-semibold text-fg">{t(locale, 'dl.flatpak.h2')}</h2>
        </div>
        <p class="mt-1 text-sm text-muted">{t(locale, 'dl.flatpak.friendly')}</p>
        <div class="mt-5 grid gap-4 lg:grid-cols-2">
          <CommandBlock
            label={t(locale, 'dl.flatpak.remote_install')}
            code={flatpakCommands(c)}
            copyLabel={t(locale, 'dl.python.copy')}
          />
          <CommandBlock
            label={t(locale, 'dl.flatpak.remote_add')}
            code={flatpakRemote(c)}
            copyLabel={t(locale, 'dl.python.copy')}
          />
        </div>
        <a data-asset="flatpak" href={d?.flatpak?.url ?? '#'} class:list={[btnGhost, 'mt-4', !d?.flatpak && 'hidden']}>
          {t(locale, 'dl.flatpak.btn')}
        </a>
        <p class="mt-4 text-xs text-faint">{t(locale, 'dl.flatpak.remote_note')}</p>
        {c !== 'stable' && (
          <p class="mt-2 text-xs text-faint">{t(locale, 'dl.flatpak.remote_channels')}</p>
        )}
        <ShaDetails locale={locale} downloads={d} keys={['flatpak']} />
      </div>
    </section>
    );
  })}

  <p class="mx-auto flex max-w-6xl items-center justify-center gap-2 px-5 pb-16 pt-4 text-xs text-faint">
    <span>{t(locale, 'dl.cdn_powered')}</span>
    <a href="https://bunny.net/" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:opacity-85" title="bunny.net">
      <img src="/vendor/bunny-logo-orange.svg" alt="" width="22" height="25" class="h-6 w-auto" />
      <span class="font-medium text-muted">bunny.net</span>
    </a>
  </p>

  <script type="application/json" id="dl-data" set:html={JSON.stringify(payload)} />

  <script define:vars={{ selectLabel: t(locale, 'js.download.select_version'), apiBase: SITE.apiBase, copiedLabel: t(locale, 'js.copied'), copyShaLabel: t(locale, 'dl.copy_sha256') }}>
    const dataEl = document.getElementById('dl-data');
    const data = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
    const versionSel = document.getElementById('dl-version');
    const sourceWrap = document.getElementById('dl-source-wrap');
    const meta = document.getElementById('dl-release-meta');
    let channel = 'stable';
    const params = new URLSearchParams(location.search);
    let source = params.get('source') === 'github' ? 'github' : 'bunny';

    function sourceTabs() {
      return document.querySelectorAll('.dl-source-tab');
    }

    function paintSource() {
      sourceTabs().forEach((b) => {
        const on = b.getAttribute('data-source') === source;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      });
    }

    function fmtDate(iso) {
      try {
        return new Date(iso).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' });
      } catch {
        return iso || '';
      }
    }

    function currentRelease() {
      const list = data[channel] || [];
      const tag = versionSel?.value;
      return list.find((r) => r.tag === tag) || list[0] || null;
    }

    function fillVersions() {
      if (!versionSel) return;
      const list = data[channel] || [];
      versionSel.innerHTML = list
        .slice(0, 20)
        .map((r) => `<option value="${r.tag}">v${r.version}</option>`)
        .join('');
      versionSel.classList.toggle('hidden', list.length === 0);
    }

    function assetHref(asset) {
      if (!asset) return '';
      if (source === 'bunny' && asset.cdnUrl) return asset.cdnUrl;
      if (source === 'github' && asset.githubUrl) return asset.githubUrl;
      return asset.url || '';
    }

    function syncSource(rel) {
      const servers = Array.isArray(rel?.downloadServers) ? rel.downloadServers : [];
      sourceWrap?.classList.toggle('hidden', servers.length < 2);
      if (servers.length < 2) {
        source = servers[0] || 'github';
        paintSource();
        return;
      }
      if (!servers.includes(source)) source = rel.downloadServer || servers[0];
      paintSource();
    }

    function applyRelease() {
      const rel = currentRelease();
      const panel = document.querySelector(`[data-channel-panel="${channel}"]`);
      if (!panel || !rel) return;
      syncSource(rel);
      const dl = rel.downloads || {};
      panel.querySelectorAll('.dl-link').forEach((a) => {
        const key = a.getAttribute('data-asset');
        if (!key) return;
        const asset = dl[key] || null;
        a.classList.toggle('hidden', !asset);
        a.classList.toggle('inline-flex', !!asset && !a.classList.contains('btn-mini'));
        if (asset) a.href = assetHref(asset);
      });
      panel.querySelectorAll('[data-asset-none]').forEach((el) => {
        const has = !!dl.winInstaller;
        el.classList.toggle('hidden', has);
      });
      panel.querySelectorAll('[data-magnet-from]').forEach((btn) => {
        const key = btn.getAttribute('data-magnet-from');
        const asset = key ? dl[key] : null;
        const mag = asset?.magnet || '';
        btn.classList.toggle('hidden', !mag);
        if (mag) btn.setAttribute('data-copy', mag);
      });
      panel.querySelectorAll('[data-platform="torrent"]').forEach((card) => {
        card.classList.toggle('hidden', !dl.torrent);
      });
      panel.querySelectorAll('[data-sha256-card]').forEach((det) => {
        const keys = (det.getAttribute('data-sha-keys') || '').split(',').filter(Boolean);
        const list = det.querySelector('[data-sha256-list]');
        if (!list) return;
        list.innerHTML = '';
        const rows = keys
          .map((k) => dl[k])
          .filter((a) => a && a.sha256);
        const copyIcon =
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/></svg>';
        const makeBox = (text) => {
          const box = document.createElement('div');
          box.className = 'dl-sha256-box';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'hash-copy dl-sha256-copy';
          btn.setAttribute('data-copy', text);
          btn.setAttribute('data-copied', copiedLabel);
          btn.setAttribute('aria-label', copyShaLabel);
          btn.title = copyShaLabel;
          btn.innerHTML = copyIcon;
          const code = document.createElement('code');
          code.textContent = text;
          box.appendChild(btn);
          box.appendChild(code);
          return box;
        };
        if (det.hasAttribute('data-sha-combined')) {
          list.appendChild(makeBox(rows.map((a) => `${a.sha256}  ${a.name}`).join('\n')));
        } else {
          for (const a of rows) {
            const row = document.createElement('div');
            row.className = 'dl-sha256-row';
            const nm = document.createElement('span');
            nm.className = 'dl-sha256-name';
            nm.textContent = a.name || '';
            row.appendChild(nm);
            row.appendChild(makeBox(a.sha256));
            list.appendChild(row);
          }
        }
        det.classList.toggle('hidden', rows.length === 0);
      });
      if (meta) {
        meta.innerHTML = '';
        const a = document.createElement('a');
        a.href = rel.releaseUrl;
        a.className = 'underline decoration-line underline-offset-2 hover:text-fg';
        a.textContent = `v${rel.version} · ${fmtDate(rel.publishedAt)}`;
        meta.appendChild(a);
      }
    }

    document.querySelectorAll('.channel-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        channel = btn.getAttribute('data-channel') || 'stable';
        document.querySelectorAll('.channel-tab').forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-selected', String(on));
          b.className =
            'channel-tab rounded-md px-4 py-1.5 text-sm font-medium transition-colors ' +
            (on ? 'bg-raised text-fg' : 'text-muted hover:text-fg');
        });
        document.querySelectorAll('[data-channel-panel]').forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-channel-panel') !== channel);
        });
        fillVersions();
        applyRelease();
      });
    });

    versionSel?.addEventListener('change', applyRelease);
    sourceTabs().forEach((btn) => {
      btn.addEventListener('click', () => {
        source = btn.getAttribute('data-source') === 'github' ? 'github' : 'bunny';
        const next = new URL(location.href);
        if (source === 'github') next.searchParams.set('source', 'github');
        else next.searchParams.delete('source');
        history.replaceState(null, '', next);
        paintSource();
        applyRelease();
      });
    });

    // pip/pipx/uv/pyz/pip-rns tabs inside the Python card
    document.querySelectorAll('.pip-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-pip-tab');
        const card = btn.closest('[data-platform="python"]');
        card?.querySelectorAll('.pip-tab').forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-selected', String(on));
          b.className =
            'pip-tab rounded-md px-2.5 py-1 text-xs font-medium transition-colors ' +
            (on ? 'bg-raised text-fg' : 'text-muted hover:text-fg');
        });
        card?.querySelectorAll('.pip-panel').forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-pip-panel') !== target);
        });
      });
    });

    document.querySelectorAll('.engine-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-engine-tab');
        const card = btn.closest('[data-platform="containers"]');
        card?.querySelectorAll('.engine-tab').forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-selected', String(on));
          b.className =
            'engine-tab inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium ' +
            (on ? 'bg-raised text-fg' : 'text-muted hover:text-fg');
        });
        card?.querySelectorAll('.engine-panel').forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-engine-panel') !== target);
        });
      });
    });

    // UA-based recommendation
    const ua = navigator.userAgent.toLowerCase();
    const plat = /android/.test(ua) ? 'android' : /win/.test(ua) ? 'win' : /mac|iphone|ipad/.test(ua) ? 'mac' : /linux/.test(ua) ? 'linux' : '';
    if (plat) {
      document.querySelectorAll(`.dl-card[data-platform="${plat}"]`).forEach((card) => {
        card.classList.add('ring-1', 'ring-fg/40');
        card.querySelector('.dl-rec')?.classList.remove('hidden');
      });
    }

    fillVersions();
    applyRelease();

    // Delegated so rebuilt sha256 rows keep working.
    document.addEventListener('click', async (ev) => {
      const btn = ev.target instanceof Element ? ev.target.closest('.hash-copy') : null;
      if (!btn) return;
      const text = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      if (!btn.textContent.trim()) {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1400);
      } else {
        const orig = btn.textContent;
        btn.textContent = btn.getAttribute('data-copied') || 'Copied';
        setTimeout(() => {
          btn.textContent = orig;
        }, 1400);
      }
    });

    // Live refresh: swap baked release data for the API payload when reachable.
    {
      const idle = window.requestIdleCallback || ((fn) => setTimeout(fn, 1));
      idle(() => fetch(`${apiBase}/api/releases`)
      .then((r) => (r.ok ? r.json() : null))
      .then((live) => {
        if (!live?.channels) return;
        for (const ch of ['stable', 'beta', 'testing']) {
          if (live.channels[ch]?.length) data[ch] = live.channels[ch];
        }
        fillVersions();
        applyRelease();
      })
      .catch(() => {}));
    }
  </script>
</Base>

<style>
  .arch-warn {
    border-color: color-mix(in srgb, var(--color-warn) 50%, var(--color-line));
    color: var(--color-warn);
    background: var(--color-canvas);
  }
</style>

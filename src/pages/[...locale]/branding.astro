---
import { readdirSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ThemeImage from '../../components/ThemeImage.astro';
import { LOCALES, BRAND_SECTIONS, BRAND_COLORS, type Locale } from '../../config/site';
import { t } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const bySize = (files: string[]) =>
  [...files].sort((a, b) => {
    const sa = parseInt(a.match(/-(\d+)/)?.[1] ?? '0', 10);
    const sb = parseInt(b.match(/-(\d+)/)?.[1] ?? '0', 10);
    return sa - sb;
  });

// Group files by format: svg, png, webp, jpg-dark, jpg-light, ico
function groupFiles(files: string[]) {
  const groups: { label: string; files: string[] }[] = [];
  const pick = (test: (f: string) => boolean, label: string) => {
    const hits = bySize(files.filter(test));
    if (hits.length) groups.push({ label, files: hits });
  };
  pick((f) => f.endsWith('.svg'), 'SVG');
  pick((f) => f.endsWith('.png'), 'PNG');
  pick((f) => f.endsWith('.webp'), 'WebP');
  pick((f) => f.endsWith('-dark.jpg'), 'JPG dark');
  pick((f) => f.endsWith('-light.jpg'), 'JPG light');
  pick((f) => f.endsWith('.ico'), 'ICO');
  return groups;
}

const sections = BRAND_SECTIONS.map((s) => {
  const files = readdirSync(`public/media/branding/${s.key}`);
  const largest = (suffix: string) => bySize(files.filter((f) => f.endsWith(suffix))).pop();
  // theme-matched previews first (baked backgrounds), else a transparent
  // format that sits on the raised preview surface
  const previewDark = largest('-dark.jpg') ?? files.find((f) => f.endsWith('.svg')) ?? largest('.webp') ?? largest('.png') ?? files[0];
  const previewLight = largest('-light.jpg') ?? files.find((f) => f.endsWith('.svg')) ?? largest('.webp') ?? largest('.png') ?? files[0];
  return { ...s, previewDark, previewLight, groups: groupFiles(files) };
});
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.branding')}
  description={t(locale, 'meta.desc.branding')}
  ogCard="card-branding"
  path="branding"
>
  <PageHero title={t(locale, 'branding.h1')} lead={t(locale, 'branding.lead')} />

  <div class="mx-auto max-w-6xl px-5 pb-24">
    <section class="mb-14">
      <h2 class="text-2xl font-semibold tracking-tight text-fg">{t(locale, 'branding.colors_h2')}</h2>
      <p class="mt-2 text-sm text-muted">{t(locale, 'branding.colors_lead')}</p>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        {BRAND_COLORS.map((c) => (
          <div class="overflow-hidden rounded-lg border border-line">
            <div class="h-16" style={`background:${c.hex}`}></div>
            <div class="bg-surface px-3 py-2">
              <p class="text-xs font-medium text-fg">{c.name}</p>
              <p class="font-mono text-[11px] text-faint">{c.hex}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {sections.map((s) => (
      <section class="mb-14">
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{t(locale, s.h)}</h2>
        <p class="mt-2 text-sm text-muted">{t(locale, s.lead)}</p>
        <div class="mt-6 rounded-xl border border-line bg-surface p-6">
          <div class="flex h-32 items-center justify-center overflow-hidden rounded-lg bg-raised">
            <ThemeImage
              dark={`/media/branding/${s.key}/${s.previewDark}`}
              light={`/media/branding/${s.key}/${s.previewLight}`}
              alt={t(locale, s.h)}
              class="max-h-24 max-w-full object-contain"
              loading="lazy"
            />
          </div>
          <div class="mt-5 space-y-3">
            {s.groups.map((g) => (
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="w-16 shrink-0 font-mono text-[10px] font-bold uppercase tracking-wider text-faint">{g.label}</span>
                {g.files.map((f) => (
                  <a
                    href={`/media/branding/${s.key}/${f}`}
                    class="inline-block rounded px-1.5 py-1.5 font-mono text-xs text-muted underline decoration-line underline-offset-4 transition-colors hover:text-fg"
                  >
                    {f.replace(/^[^-]+-?/, '').replace(/\.(svg|png|webp|jpg|ico)$/, '') || f}
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { LOCALES, type Locale } from '../../config/site';
import { t } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const sections = [
  {
    key: 'lockup',
    h: 'branding.lockup_h2',
    lead: 'branding.lockup_lead',
    files: ['lockup-128.webp', 'lockup-256.webp', 'lockup-512.webp', 'lockup-128.png', 'lockup-256.png', 'lockup-512.png', 'lockup-128-dark.jpg', 'lockup-256-dark.jpg', 'lockup-128-light.jpg', 'lockup-256-light.jpg'],
  },
  {
    key: 'logo',
    h: 'branding.logo_h2',
    lead: 'branding.logo_lead',
    files: ['logo-32.webp', 'logo-64.webp', 'logo-128.webp', 'logo-256.webp', 'logo-512.webp', 'logo-800.webp', 'logo-128.png', 'logo-256.png', 'logo-512.png', 'logo-800.png', 'logo-128-dark.jpg', 'logo-256-dark.jpg', 'logo-512-dark.jpg', 'logo-128-light.jpg', 'logo-256-light.jpg', 'logo-512-light.jpg'],
  },
  {
    key: 'wordmark',
    h: 'branding.wordmark_h2',
    lead: 'branding.wordmark_lead',
    files: ['wordmark-128.webp', 'wordmark-256.webp', 'wordmark-512.webp', 'wordmark-128.png', 'wordmark-256.png', 'wordmark-512.png', 'wordmark-128-dark.jpg', 'wordmark-128-light.jpg'],
  },
  {
    key: 'icon',
    h: 'branding.icon_h2',
    lead: 'branding.icon_lead',
    files: ['icon-16.webp', 'icon-32.webp', 'icon-48.webp', 'icon-64.webp', 'icon-128.webp', 'icon-256.webp', 'icon-512.webp', 'icon-800.webp', 'favicon.ico'],
  },
];

const colors = [
  { name: 'Void 900', hex: '#0a0a0b', dark: true },
  { name: 'Void 850', hex: '#101013', dark: true },
  { name: 'Void 700', hex: '#1f1f24', dark: true },
  { name: 'Mist 400', hex: '#a1a1aa', dark: true },
  { name: 'Paper 100', hex: '#f4f4f5', dark: false },
  { name: 'Paper 50', hex: '#fafafa', dark: false },
  { name: 'Accent Blue', hex: '#2563eb', dark: true },
];
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.branding')}
  description={t(locale, 'meta.desc.branding')}
  ogCard="card-branding"
  path="branding"
>
  <PageHero title={t(locale, 'branding.h1')} lead={t(locale, 'branding.lead')} />

  <div class="mx-auto max-w-6xl px-5 pb-24">
    <section class="mb-14">
      <h2 class="text-2xl font-semibold tracking-tight text-fg">{t(locale, 'branding.colors_h2')}</h2>
      <p class="mt-2 text-sm text-muted">{t(locale, 'branding.colors_lead')}</p>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        {colors.map((c) => (
          <div class="overflow-hidden rounded-lg border border-line">
            <div class="h-16" style={`background:${c.hex}`}></div>
            <div class="bg-surface px-3 py-2">
              <p class="text-xs font-medium text-fg">{c.name}</p>
              <p class="font-mono text-[11px] text-faint">{c.hex}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {sections.map((s) => (
      <section class="mb-14">
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{t(locale, s.h)}</h2>
        <p class="mt-2 text-sm text-muted">{t(locale, s.lead)}</p>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {s.files.map((f) => (
            <a
              href={`/media/branding/${s.key}/${f}`}
              class="group rounded-lg border border-line bg-surface p-4 transition-colors hover:bg-raised"
            >
              <div class="flex h-20 items-center justify-center">
                <img src={`/media/branding/${s.key}/${f}`} alt={f} loading="lazy" class="max-h-16 max-w-full object-contain" />
              </div>
              <p class="mt-3 truncate text-center font-mono text-[10px] text-faint group-hover:text-muted">{f}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

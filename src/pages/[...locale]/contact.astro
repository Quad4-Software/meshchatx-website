---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CommandBlock from '../../components/CommandBlock.astro';
import { LOCALES, CONTACT, type Locale } from '../../config/site';
import { t } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.contact')}
  description={t(locale, 'meta.desc.contact')}
  ogCard="card-contact"
  path="contact"
>
  <PageHero title={t(locale, 'contact.h1')} />

  <div class="mx-auto max-w-3xl px-5 pb-24">
    <div class="space-y-4">
      <section class="rounded-xl border border-line bg-surface p-6">
        <h2 class="font-semibold text-fg">{t(locale, 'contact.panel_title')}</h2>
        <p class="mt-1 text-sm text-muted">LXMF</p>
        <div class="mt-4">
          <CommandBlock label={t(locale, 'contact.copy_title')} code={CONTACT.lxmf} copyLabel={t(locale, 'contact.copy_title')} />
        </div>
      </section>

      <section class="rounded-xl border border-line bg-surface p-6">
        <h2 class="font-semibold text-fg">{t(locale, 'contact.panel_email')}</h2>
        <p class="mt-1 text-sm text-muted">{t(locale, 'contact.email_lead')}</p>
        <a
          href={`mailto:${CONTACT.email}`}
          class="mt-4 inline-block rounded-lg border border-line px-4 py-2 font-mono text-sm text-fg hover:bg-raised"
        >
          {CONTACT.email}
        </a>
      </section>
    </div>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { LOCALES, type Locale } from '../../config/site';
import { ROADMAP } from '../../config/roadmap';
import { t, localePath } from '../../i18n';
import { publishedVersions } from '../../lib/releases';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const published = await publishedVersions();

const verCmp = (a: string, b: string) =>
  a.split('.').map(Number).reduce((acc, p, i) => acc || p - (Number(b.split('.')[i]) || 0), 0);

let markedUpcoming = false;
const items = ROADMAP.map((item) => {
  let status = item.status;
  const shipped = published.some((v) => verCmp(v, item.version) >= 0);
  if (status === 'planned' && shipped) {
    status = 'done';
  } else if (status === 'planned' && !markedUpcoming) {
    status = 'upcoming';
    markedUpcoming = true;
  }
  return { ...item, status, shipped };
});

// Rail: milestones only. Patch releases get a count badge under each milestone.
interface RailNode {
  version: string;
  label: string;
  title: string;
  date: string;
  status: string;
  done: boolean;
  patches: string[];
}
const rail: RailNode[] = [];
const sorted = [...items].sort((a, b) => verCmp(a.version, b.version));
for (let i = 0; i < sorted.length; i++) {
  const m = sorted[i]!;
  const next = sorted[i + 1]?.version;
  const patches = published
    .filter(
      (v) =>
        verCmp(v, m.version) > 0 &&
        v.split('.').slice(0, 2).join('.') === m.version.split('.').slice(0, 2).join('.') &&
        (!next || verCmp(v, next) < 0),
    )
    .sort(verCmp);
  rail.push({
    version: m.version,
    label: `v${m.version}`,
    title: m.title,
    date: m.date,
    status: m.status,
    done: m.shipped || m.status === 'done',
    patches,
  });
}
// Road fills up to the last shipped version: the shipped milestone's node, or
// the furthest patch tick beyond it when patch releases landed. A milestone
// still marked in progress counts once its version line is published.
let progress = 0;
for (let i = rail.length - 1; i >= 0; i--) {
  const r = rail[i]!;
  if (!r.done) continue;
  const p = r.patches.length;
  const tickOffset = p > 0 ? p / (p + 1) : 0;
  progress = i === rail.length - 1 ? 1 : (i + 0.5 + tickOffset) / rail.length;
  break;
}

const statusStyle = {
  done: 'border-line text-faint',
  progress: 'border-fg text-fg',
  planned: 'border-line text-muted',
  upcoming: 'border-faint text-muted',
} as const;
const statusKey = {
  done: 'roadmap.status_done',
  progress: 'roadmap.status_progress',
  planned: 'roadmap.status_planned',
  upcoming: 'roadmap.status_upcoming',
} as const;
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.roadmap')}
  description={t(locale, 'meta.desc.roadmap')}
  ogCard="card-roadmap"
  path="roadmap"
>
  <PageHero title={t(locale, 'roadmap.h1')} lead={t(locale, 'roadmap.lead')} />

  <div class="mx-auto max-w-6xl px-5 pb-24">
    <p class="mb-10 font-mono text-xs text-faint">{t(locale, 'roadmap.notice')}</p>

    <!-- Version rail: overflow hidden, oldest versions clip off the left -->
    <div class="rail-outer mb-14 overflow-hidden" role="img" aria-label={t(locale, 'roadmap.rail_label')}>
      <div class="rail-wrap">
        <div class="rail-track" style="position:absolute;left:0;right:0;top:3.5rem;height:16px;pointer-events:none">
          <div class="rail-line" style="position:absolute;left:0;right:0;top:50%;height:1px;transform:translateY(-50%);background-image:repeating-linear-gradient(to right, var(--color-line) 0 8px, transparent 8px 16px)"></div>
          <div class="rail-progress" style={`position:absolute;left:0;top:50%;height:1px;background:var(--color-fg);width:${(progress * 100).toFixed(1)}%`}></div>
          <span class="rail-now" style={`position:absolute;top:50%;width:0.625rem;height:0.625rem;border-radius:9999px;background:var(--color-fg);left:${(progress * 100).toFixed(1)}%`}></span>
        </div>
        <ol class="rail-list">
          {rail.map((node) => (
            <li class="rail-col">
              <div class="rail-node" style="position:relative;display:flex;width:100%;height:16px;align-items:center;justify-content:center">
                {node.patches.map((p, i) => (
                  <span
                    class="rail-tick"
                    style={`left:${(50 + ((i + 1) / (node.patches.length + 1)) * 100).toFixed(2)}%`}
                    title={`v${p}`}
                  >
                    <span class="rail-tick-label">{p}</span>
                    <span class="rail-tick-stem"></span>
                  </span>
                ))}
                <a
                  href={`#ms-${node.version.replace(/\./g, '-')}`}
                  class="rail-dot-link"
                  title={`${node.label} · ${node.title}`}
                >
                  <span
                    class:list={[
                      'rail-dot',
                      node.done && 'is-done',
                      node.status === 'progress' && 'is-progress',
                    ]}
                    style={
                      node.done
                        ? 'display:block;width:16px;height:16px;border-radius:9999px;border:2px solid var(--color-fg);background:var(--color-fg)'
                        : node.status === 'progress'
                          ? 'display:block;width:16px;height:16px;border-radius:9999px;border:2px solid var(--color-fg);background:var(--color-canvas)'
                          : 'display:block;width:16px;height:16px;border-radius:9999px;border:2px solid var(--color-line);background:var(--color-canvas)'
                    }
                  ></span>
                </a>
              </div>
              <a
                href={`#ms-${node.version.replace(/\./g, '-')}`}
                class="rail-meta"
                style="display:flex;flex-direction:column;align-items:center;margin-top:0.4rem"
                title={`${node.label} · ${node.title}`}
              >
                <span class="rail-ver">{node.label}</span>
                {node.date && <span class="rail-date">{node.date}</span>}
                {node.patches.length > 0 && (
                  <span class="rail-count">+{node.patches.length}</span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Milestone cards -->
    <div class="relative space-y-6 border-l border-line pl-8">
      {items.map((item, i) => (
        <article
          id={`ms-${item.version.replace(/\./g, '-')}`}
          class="ms-card relative scroll-mt-24"
          style={`--ms-delay:${i * 90}ms`}
        >
          <span class="absolute -left-[37px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-canvas bg-fg"></span>
          <div class="rounded-xl border border-line bg-surface p-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-mono text-lg font-bold text-fg">v{item.version}</span>
              <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider ${statusStyle[item.status]}`}>
                {t(locale, statusKey[item.status])}
              </span>
              <span class="ml-auto font-mono text-xs text-faint">{item.date}</span>
            </div>
            <h2 class="mt-3 text-lg font-semibold text-fg">{item.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.desc}</p>
            <ul class="mt-4 grid gap-x-6 gap-y-1.5 text-sm text-muted sm:grid-cols-2">
              {item.features.map((f) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-faint"></span>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12">
      <a href={localePath(locale, 'changelog')} class="text-sm text-muted underline decoration-line underline-offset-4 hover:text-fg">
        {t(locale, 'roadmap.changelog_preview')}
      </a>
    </div>
  </div>

  <style is:global>
    .rail-outer {
      overflow: hidden;
      width: 100%;
      max-width: 100%;
      padding-bottom: 0.5rem;
    }
    .rail-wrap {
      position: relative;
      width: 100%;
      padding-top: 3.5rem;
    }
    .rail-track {
      pointer-events: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 3.5rem;
      height: 16px;
    }
    .rail-line {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 1px;
      transform: translateY(-50%);
      background-image: repeating-linear-gradient(
        to right,
        var(--color-line) 0 8px,
        transparent 8px 16px
      );
    }
    .rail-progress {
      position: absolute;
      left: 0;
      top: 50%;
      height: 1px;
      background: var(--color-fg);
      transform-origin: left center;
      animation: railGrow 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .rail-now {
      position: absolute;
      top: 50%;
      width: 0.625rem;
      height: 0.625rem;
      border-radius: 9999px;
      background: var(--color-fg);
      z-index: 20;
      animation: railNow 0.35s ease-out 0.7s both;
    }
    .rail-list {
      display: flex;
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .rail-col {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow: visible;
    }
    @media (max-width: 720px) {
      /* Wider than the viewport: scroll horizontally instead of clipping the
         oldest milestones off the left edge. */
      .rail-outer {
        overflow-x: auto;
        scrollbar-width: thin;
      }
      .rail-wrap {
        width: max-content;
        min-width: 100%;
        margin-inline: auto;
      }
      .rail-col {
        flex: 0 0 6.25rem;
        min-width: 6.25rem;
      }
    }
    .rail-node {
      position: relative;
      display: flex;
      width: 100%;
      height: 16px;
      align-items: center;
      justify-content: center;
    }
    .rail-dot-link {
      position: relative;
      z-index: 12;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 24px;
      min-height: 24px;
    }
    .rail-dot {
      display: block;
      width: 16px;
      height: 16px;
      border-radius: 9999px;
      border: 2px solid var(--color-line);
      background: var(--color-canvas);
    }
    .rail-dot.is-done {
      border-color: var(--color-fg);
      background: var(--color-fg);
    }
    .rail-dot.is-progress {
      border-color: var(--color-fg);
      background: var(--color-canvas);
    }
    .rail-dot-link:hover .rail-dot {
      transform: scale(1.2);
    }
    .rail-tick {
      position: absolute;
      bottom: 100%;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      transform: translateX(-50%);
      padding-bottom: 0.4rem;
      pointer-events: none;
    }
    .rail-tick-label {
      margin-bottom: 0.3rem;
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1;
      letter-spacing: 0.04em;
      color: var(--color-faint);
      writing-mode: vertical-rl;
    }
    .rail-tick-stem {
      width: 1px;
      height: 0.5rem;
      background: color-mix(in srgb, var(--color-faint) 70%, transparent);
    }
    .rail-tick:hover .rail-tick-label {
      color: var(--color-fg);
    }
    .rail-tick:hover .rail-tick-stem {
      background: var(--color-fg);
    }
    .rail-meta {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 0.4rem;
    }
    .rail-ver {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      color: var(--color-fg);
    }
    .rail-date {
      margin-top: 2px;
      font-size: 10px;
      color: var(--color-faint);
    }
    .rail-count {
      margin-top: 4px;
      border: 1px solid var(--color-line);
      border-radius: 9999px;
      padding: 1px 6px;
      font-family: var(--font-mono);
      font-size: 9px;
      color: var(--color-faint);
    }
    .ms-card {
      animation: msIn 0.55s ease-out both;
      animation-delay: var(--ms-delay, 0ms);
    }
    @keyframes railGrow {
      from {
        transform: translateY(-50%) scaleX(0);
      }
      to {
        transform: translateY(-50%) scaleX(1);
      }
    }
    @keyframes railNow {
      from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.4);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
    }
    @keyframes msIn {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .rail-progress,
      .rail-now,
      .ms-card {
        animation: none;
      }
      .rail-progress {
        transform: translateY(-50%);
      }
      .rail-now {
        transform: translate(-50%, -50%);
      }
    }
  </style>
</Base>

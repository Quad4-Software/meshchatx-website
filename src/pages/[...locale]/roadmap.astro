---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { LOCALES, type Locale } from '../../config/site';
import { ROADMAP } from '../../config/roadmap';
import { t, localePath } from '../../i18n';
import { publishedVersions } from '../../lib/releases';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const published = await publishedVersions();

const verCmp = (a: string, b: string) =>
  a.split('.').map(Number).reduce((acc, p, i) => acc || p - (Number(b.split('.')[i]) || 0), 0);

let markedUpcoming = false;
const items = ROADMAP.map((item) => {
  let status = item.status;
  const shipped = published.some((v) => verCmp(v, item.version) >= 0);
  if (status === 'planned' && shipped) {
    status = 'done';
  } else if (status === 'planned' && !markedUpcoming) {
    status = 'upcoming';
    markedUpcoming = true;
  }
  return { ...item, status };
});

// Rail: milestones only. Patch releases get a count badge under each milestone.
interface RailNode {
  version: string;
  label: string;
  title: string;
  date: string;
  status: string;
  done: boolean;
  patches: string[];
}
const rail: RailNode[] = [];
const sorted = [...items].sort((a, b) => verCmp(a.version, b.version));
for (let i = 0; i < sorted.length; i++) {
  const m = sorted[i]!;
  const next = sorted[i + 1]?.version;
  const patches = published
    .filter(
      (v) =>
        verCmp(v, m.version) > 0 &&
        v.split('.').slice(0, 2).join('.') === m.version.split('.').slice(0, 2).join('.') &&
        (!next || verCmp(v, next) < 0),
    )
    .sort(verCmp);
  rail.push({
    version: m.version,
    label: `v${m.version}`,
    title: m.title,
    date: m.date,
    status: m.status,
    done: m.status === 'done',
    patches,
  });
}
const doneCount = rail.filter((r) => r.done).length;
const progress = rail.length > 1 ? (doneCount - 1) / (rail.length - 1) : 1;

const statusStyle = {
  done: 'border-line text-faint',
  progress: 'border-fg text-fg',
  planned: 'border-line text-muted',
  upcoming: 'border-faint text-muted',
} as const;
const statusKey = {
  done: 'roadmap.status_done',
  progress: 'roadmap.status_progress',
  planned: 'roadmap.status_planned',
  upcoming: 'roadmap.status_upcoming',
} as const;
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.roadmap')}
  description={t(locale, 'meta.desc.roadmap')}
  ogCard="card-roadmap"
  path="roadmap"
>
  <PageHero title={t(locale, 'roadmap.h1')} lead={t(locale, 'roadmap.lead')} />

  <div class="mx-auto max-w-6xl px-5 pb-24">
    <p class="mb-10 font-mono text-xs text-faint">{t(locale, 'roadmap.notice')}</p>

    <!-- Version rail -->
    <div class="mb-14 overflow-x-auto pb-4" role="img" aria-label={t(locale, 'roadmap.rail_label')}>
      <div class="relative min-w-[720px] pt-8">
        <div class="absolute left-0 right-0 top-[9px] h-px" style="background-image: repeating-linear-gradient(to right, var(--color-line) 0 8px, transparent 8px 16px)"></div>
        <div
          class="absolute left-0 top-[9px] h-px bg-fg transition-[width]"
          style={`width:${(progress * 100).toFixed(1)}%`}
        ></div>
        <ol class="relative flex justify-between">
          {rail.map((node) => (
            <li class="relative flex flex-col items-center" style={`flex:1`}>
              {node.patches.map((p, i) => (
                <a
                  href={localePath(locale, `changelog#v-${p}`)}
                  class="group/tick absolute top-[4px] block w-3"
                  style={`left:calc(50% + ${((0.12 + ((i + 1) / (node.patches.length + 1)) * 0.76) * 100).toFixed(2)}%); transform:translateX(-50%)`}
                  title={`v${p}`}
                >
                  <span class="mx-auto block h-2.5 w-px bg-faint/70 transition-colors group-hover/tick:bg-fg"></span>
                  <span
                    class="absolute left-1/2 top-3 -translate-x-1/2 font-mono text-[9px] text-faint transition-colors group-hover/tick:text-fg"
                    style="writing-mode: vertical-rl;"
                  >v{p}</span>
                </a>
              ))}
              <a
                href={`#ms-${node.version.replace(/\./g, '-')}`}
                class="group flex flex-col items-center"
                title={`${node.label} · ${node.title}`}
              >
                <span
                  class:list={[
                    'block rounded-full border-2 transition-transform group-hover:scale-125 h-4 w-4',
                    node.done ? 'border-fg bg-fg' : node.status === 'progress' ? 'border-fg bg-canvas' : 'border-line bg-canvas',
                  ]}
                ></span>
                <span class="block h-2 w-px bg-line" aria-hidden="true"></span>
                <span class="mt-1.5 font-mono text-[11px] font-semibold text-fg">
                  {node.label}
                </span>
                {node.date && (
                  <span class="mt-0.5 text-[10px] text-faint">{node.date}</span>
                )}
                {node.patches.length > 0 && (
                  <span class="mt-1 rounded-full border border-line px-1.5 py-px font-mono text-[9px] text-faint">
                    +{node.patches.length}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Milestone cards -->
    <div class="relative space-y-6 border-l border-line pl-8">
      {items.map((item) => (
        <article id={`ms-${item.version.replace(/\./g, '-')}`} class="relative scroll-mt-24">
          <span class="absolute -left-[37px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-canvas bg-fg"></span>
          <div class="rounded-xl border border-line bg-surface p-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-mono text-lg font-bold text-fg">v{item.version}</span>
              <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider ${statusStyle[item.status]}`}>
                {t(locale, statusKey[item.status])}
              </span>
              <span class="ml-auto font-mono text-xs text-faint">{item.date}</span>
            </div>
            <h2 class="mt-3 text-lg font-semibold text-fg">{item.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.desc}</p>
            <ul class="mt-4 grid gap-x-6 gap-y-1.5 text-sm text-muted sm:grid-cols-2">
              {item.features.map((f) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-faint"></span>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12">
      <a href={localePath(locale, 'changelog')} class="text-sm text-muted underline decoration-line underline-offset-4 hover:text-fg">
        {t(locale, 'roadmap.changelog_preview')}
      </a>
    </div>
  </div>
</Base>

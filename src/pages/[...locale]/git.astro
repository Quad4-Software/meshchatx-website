---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, SITE, type Locale } from '../../config/site';
import { t } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

type Host = {
  key: string;
  primary: boolean;
  logo?: string;
  icon?: string;
  iconSize?: number;
  url?: string;
  commands: { label: string; cmd: string }[];
};

const hosts: Host[] = [
  {
    key: 'rngit',
    primary: true,
    logo: '/vendor/reticulum-logo-128.webp',
    commands: [
      { label: t(locale, 'git.clone_rns'), cmd: `git clone ${SITE.rngitRns}` },
      { label: t(locale, 'git.nomadnet'), cmd: SITE.rngitNomadnet },
    ],
  },
  {
    key: 'github',
    primary: false,
    icon: 'mdiGithub',
    iconSize: 28,
    url: SITE.githubUrl,
    commands: [{ label: 'git', cmd: `git clone ${SITE.githubClone}` }],
  },
  {
    key: 'codefloe',
    primary: false,
    icon: 'siCodefloe',
    iconSize: 32,
    url: SITE.codefloeUrl,
    commands: [{ label: 'git', cmd: `git clone ${SITE.codefloeClone}` }],
  },
];
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.git')}
  description={t(locale, 'meta.desc.git')}
  ogCard="card-git"
  path="git"
>
  <PageHero title={t(locale, 'git.h1')} lead={t(locale, 'git.lead')} />

  <div class="mx-auto max-w-6xl px-5 pb-24">
    <div class="grid gap-4 lg:grid-cols-3">
      {hosts.map((h) => (
        <article
          class:list={[
            'flex flex-col rounded-xl border bg-surface p-6',
            h.primary ? 'border-fg lg:col-span-1' : 'border-line',
          ]}
        >
          <div class="flex items-center gap-3">
            {h.logo ? (
              <img src={h.logo} alt="" width="44" height="44" class="h-11 w-11 rounded-lg" loading="lazy" decoding="async" fetchpriority="low" />
            ) : (
              <span class="flex h-11 w-11 items-center justify-center rounded-lg border border-line bg-raised text-muted">
                <Icon name={h.icon!} size={h.iconSize ?? 22} />
              </span>
            )}
            <div>
              <h2 class="text-lg font-semibold text-fg">{t(locale, `git.${h.key}_h3`)}</h2>
              <p class="font-mono text-[10px] uppercase tracking-wider text-faint">
                {t(locale, h.primary ? 'git.primary_badge' : 'git.mirror_badge')}
              </p>
            </div>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted">{t(locale, `git.${h.key}_lead`)}</p>

          <div class="mt-4 flex-1 space-y-3">
            {h.commands.map((c) => (
              <div>
                <p class="mb-1 font-mono text-[10px] uppercase tracking-wider text-faint">{c.label}</p>
                <button
                  type="button"
                  class="git-copy w-full break-all rounded-lg border border-line bg-canvas px-3 py-2 text-left font-mono text-xs text-muted transition-colors hover:border-mist-500 hover:text-fg"
                  data-copy={c.cmd}
                  data-copied={t(locale, 'git.copied')}
                  aria-label={`${t(locale, 'git.copy_cmd')}: ${c.cmd}`}
                >
                  {c.cmd}
                </button>
                <p class="mt-1 text-[11px] text-faint">{t(locale, 'git.click_copy')}</p>
              </div>
            ))}
          </div>

          {h.url && (
            <a
              href={h.url}
              class="mt-5 inline-flex items-center gap-2 self-start rounded-lg border border-line px-4 py-2 text-sm font-medium text-fg transition-colors hover:bg-raised"
            >
              <Icon name="mdiOpenInNew" size={15} />
              {t(locale, 'git.open_repo')}
            </a>
          )}
        </article>
      ))}
    </div>
  </div>

  <script>
    document.querySelectorAll('.git-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        const orig = btn.textContent;
        btn.textContent = btn.getAttribute('data-copied') || 'Copied';
        setTimeout(() => {
          btn.textContent = orig;
        }, 1400);
      });
    });
  </script>
</Base>

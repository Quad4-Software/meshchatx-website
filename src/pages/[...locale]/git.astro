---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CommandBlock from '../../components/CommandBlock.astro';
import { LOCALES, REPO_LINKS, type Locale } from '../../config/site';
import { t } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const repos = REPO_LINKS;
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.git')}
  description={t(locale, 'meta.desc.git')}
  ogCard="card-git"
  path="git"
>
  <PageHero title={t(locale, 'git.h1')} lead={t(locale, 'git.lead')} />

  <div class="mx-auto max-w-4xl space-y-4 px-5 pb-24">
    {repos.map((r) => (
      <section class="rounded-xl border border-line bg-surface p-6">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-lg font-semibold text-fg">{t(locale, r.h)}</h2>
          <span class:list={[
            'rounded-full border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider',
            r.badge === 'git.primary_badge' ? 'border-fg text-fg' : 'border-line text-faint',
          ]}>
            {t(locale, r.badge)}
          </span>
        </div>
        <p class="mt-2 text-sm text-muted">{t(locale, r.lead)}</p>
        <div class="mt-4">
          <CommandBlock label={r.label} code={r.cmd} copyLabel={t(locale, 'git.copy_cmd')} />
        </div>
        <div class="mt-3 flex gap-4">
          {r.links.map((l) => (
            <a href={l.href} class="text-sm text-muted underline decoration-line underline-offset-4 hover:text-fg">
              {t(locale, l.labelKey)}
            </a>
          ))}
        </div>
        {r.extra && (
          <p class="mt-3 font-mono text-[11px] text-faint">{r.extra}</p>
        )}
      </section>
    ))}
  </div>
</Base>

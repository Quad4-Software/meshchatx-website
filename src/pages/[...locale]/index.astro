---
import Base from '../../layouts/Base.astro';
import AppPreview from '../../components/AppPreview.astro';
import ThemeImage from '../../components/ThemeImage.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, PLATFORMS, CAPABILITIES, HOME_FEATURES, type Locale } from '../../config/site';
import { t, localePath } from '../../i18n';
import { latestForChannel } from '../../lib/releases';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const latest = await latestForChannel('stable');
const features = HOME_FEATURES;
const heroTitle = t(locale, 'home.hero.h1');
const [heroPre, heroPost] = heroTitle.split('Reticulum');
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.home')}
  description={t(locale, 'meta.desc.home')}
  ogCard="card"
  path=""
  preloadImg="/media/preview-conversation-dark-560.webp"
  preloadSrcset="/media/preview-conversation-dark-560.webp 560w, /media/preview-conversation-dark-800.webp 800w, /media/preview-conversation-dark-1120.webp 1120w, /media/preview-conversation-dark-1440.webp 1440w, /media/preview-conversation-dark-1920.webp 1920w, /media/preview-conversation-dark-2880.webp 2880w"
  preloadImgLight="/media/preview-conversation-560.webp"
  preloadSrcsetLight="/media/preview-conversation-560.webp 560w, /media/preview-conversation-800.webp 800w, /media/preview-conversation-1120.webp 1120w, /media/preview-conversation-1440.webp 1440w, /media/preview-conversation-1920.webp 1920w, /media/preview-conversation-2880.webp 2880w"
>
  <!-- Hero -->
  <section class="relative mx-auto max-w-6xl px-5 pb-10 pt-14 sm:pt-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <h1 class="text-5xl font-semibold leading-[1.02] tracking-tight text-fg sm:text-6xl">
          {heroPre}
          <a
            href="https://reticulum.network/"
            target="_blank"
            rel="noopener noreferrer"
            class="group/rns inline-flex items-baseline gap-1.5 align-baseline"
          >
            <span class="transition-opacity group-hover/rns:opacity-75">Reticulum</span>
            <img
              src="/vendor/reticulum-logo-128.webp"
              alt=""
              width="40"
              height="40"
              class="inline-block h-[0.85em] w-[0.85em] self-center"
            />
          </a>
          {heroPost}
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          {t(locale, 'home.hero.lead')}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={localePath(locale, 'download')}
            class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-85"
          >
            {latest ? t(locale, 'home.cta.download_for', { s: `v${latest.version}` }) : t(locale, 'home.cta.download')}
          </a>
          <a
            href={localePath(locale, 'git')}
            class="rounded-lg border border-line bg-surface px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:bg-raised"
          >
            {t(locale, 'home.cta.source')}
          </a>
          <a
            href={localePath(locale, 'docs')}
            class="rounded-lg px-4 py-2.5 text-sm font-medium text-muted transition-colors hover:text-fg"
          >
            {t(locale, 'home.cta.docs')}
          </a>
        </div>
        <div class="mt-8 flex flex-wrap gap-x-4 gap-y-3">
          {PLATFORMS.map((p) => (
            <a
              href={localePath(locale, `download#${p.anchor}`)}
              class="flex items-center gap-2 text-faint transition-colors hover:text-fg"
            >
              {p.icon.startsWith('img:') ? (
                <img src={p.icon.slice(4)} alt="" width="17" height="17" class="h-[17px] w-[17px] rounded-[3px] object-contain" />
              ) : (
                <Icon name={p.icon} size={17} />
              )}
              <span class="text-xs font-medium tracking-wide">
                {t(locale, `home.platform.${p.key}`)}
              </span>
            </a>
          ))}
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-[720px] overflow-hidden rounded-xl border border-line shadow-2xl shadow-black/30">
        <ThemeImage
          dark="/media/preview-conversation-dark-560.webp"
          light="/media/preview-conversation-560.webp"
          srcsetDark="/media/preview-conversation-dark-560.webp 560w, /media/preview-conversation-dark-800.webp 800w, /media/preview-conversation-dark-1120.webp 1120w, /media/preview-conversation-dark-1440.webp 1440w, /media/preview-conversation-dark-1920.webp 1920w, /media/preview-conversation-dark-2880.webp 2880w"
          srcsetLight="/media/preview-conversation-560.webp 560w, /media/preview-conversation-800.webp 800w, /media/preview-conversation-1120.webp 1120w, /media/preview-conversation-1440.webp 1440w, /media/preview-conversation-1920.webp 1920w, /media/preview-conversation-2880.webp 2880w"
          sizes="(max-width: 1024px) 92vw, 660px"
          alt="MeshChatX conversation view"
          width={1120}
          height={700}
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </section>

  <!-- Capability strip -->
  <section class="border-y border-line bg-surface-alpha backdrop-blur-sm">
    <div class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-2 px-5 py-4">
      {CAPABILITIES.map((c) => (
        <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">
          {t(locale, `home.cap.${c}`)}
        </span>
      ))}
      <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
        {t(locale, 'home.cap.more')}
      </span>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="text-3xl font-semibold tracking-tight text-fg">{t(locale, 'home.section.infra_h2')}</h2>
    <p class="mt-3 max-w-2xl text-muted">{t(locale, 'home.section.infra_lead')}</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-xl border border-line bg-surface p-6 transition-colors hover:bg-raised">
          <Icon name={f.icon} size={22} class="text-muted" />
          <h3 class="mt-3 text-base font-semibold text-fg">{t(locale, f.h)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted" set:html={t(locale, f.p)} />
        </div>
      ))}
    </div>
  </section>

  <!-- Live preview -->
  <section class="mx-auto max-w-6xl px-5 pb-20">
    <h2 class="mb-6 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
      {t(locale, 'home.preview.demo_label')}
    </h2>
    <AppPreview locale={locale} />
  </section>

  <!-- Anonymous split -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <h2 class="text-4xl font-semibold leading-tight tracking-tight text-fg sm:text-5xl">
        {t(locale, 'home.split.h2_line1')}
        <br />
        <span class="text-muted">{t(locale, 'home.split.h2_line2')}</span>
      </h2>
      <div class="space-y-6">
        {[1, 2, 3].map((i) => (
          <div class="border-l-2 border-line pl-5">
            <h3 class="font-semibold text-fg">{t(locale, `home.split.item${i}_h4`)}</h3>
            <p class="mt-1 text-sm text-muted">{t(locale, `home.split.item${i}_p`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

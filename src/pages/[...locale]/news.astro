---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { LOCALES, type Locale } from '../../config/site';
import { t, localePath } from '../../i18n';
import { getNews } from '../../lib/news';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const posts = getNews();
const rssHref = '/news.xml';
---

<Base
  locale={locale}
  title={t(locale, 'meta.title.news')}
  description={t(locale, 'meta.desc.news')}
  ogCard="card"
  path="news"
>
  <PageHero title={t(locale, 'news.h1')} lead={t(locale, 'news.lead')}>
    <p class="mt-4 text-sm">
      <a href={rssHref} class="text-muted underline decoration-line underline-offset-4 hover:text-fg">
        {t(locale, 'news.rss')}
      </a>
    </p>
  </PageHero>

  <div class="mx-auto max-w-6xl px-5 pb-24">
    {posts.length === 0 ? (
      <p class="rounded-xl border border-line bg-surface p-8 text-sm text-muted">
        {t(locale, 'news.empty')}
      </p>
    ) : (
      <div class="space-y-10">
        {posts.map((p) => (
          <article id={p.slug} class="scroll-mt-24 border-b border-line pb-8">
            <h2 class="text-xl font-semibold text-fg">
              <a href={`${localePath(locale, 'news')}#${p.slug}`} class="hover:opacity-85">{p.title}</a>
            </h2>
            <p class="mt-1 font-mono text-xs text-faint">
              {p.date.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' })}
              {p.author ? ` · ${p.author}` : ''}
            </p>
            {p.description && <p class="mt-3 text-sm text-muted">{p.description}</p>}
            {p.body && <div class="doc-body mt-4 text-sm" set:html={renderMarkdown(p.body)} />}
          </article>
        ))}
      </div>
    )}
  </div>
</Base>

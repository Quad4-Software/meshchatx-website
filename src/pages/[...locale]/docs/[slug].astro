---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { LOCALES, type Locale } from '../../../config/site';
import { t, localePath } from '../../../i18n';
import { getDoc, docsNav, allDocSlugs } from '../../../lib/docs';

export async function getStaticPaths() {
  const slugs = await allDocSlugs();
  const paths = [];
  for (const locale of LOCALES) {
    for (const slug of slugs) {
      paths.push({
        params: { locale: locale === 'en' ? undefined : locale, slug },
        props: { locale, slug },
      });
    }
  }
  return paths;
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const entry = await getDoc(locale, slug);
if (!entry) {
  throw new Error(`missing doc page: ${slug}`);
}
const { Content, headings } = await render(entry);
const nav = await docsNav(locale);
const flatNav = nav.flatMap((g) => g.items);
const idx = flatNav.findIndex((i) => i.slug === slug);
const prev = idx > 0 ? flatNav[idx - 1] : null;
const next = idx >= 0 && idx < flatNav.length - 1 ? flatNav[idx + 1] : null;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base
  locale={locale}
  title={`${entry.data.title} | ${t(locale, 'docs.meta_suffix')}`}
  description={entry.data.description ?? t(locale, 'meta.desc.docs')}
  ogCard="card-docs"
  path={`docs/${slug}`}
>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-10 lg:grid-cols-[240px_1fr_200px]">
    <!-- Sidebar -->
    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <div class="relative mb-5">
          <input
            id="docs-search"
            type="search"
            placeholder={t(locale, 'docs.search_placeholder')}
            aria-label={t(locale, 'docs.search_placeholder')}
            autocomplete="off"
            class="w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-fg placeholder:text-faint focus:border-mist-500 focus:outline-none"
          />
          <ul
            id="docs-results"
            class="absolute left-0 right-0 top-full z-30 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-line bg-surface p-1 shadow-xl"
          ></ul>
        </div>
        <nav class="max-h-[calc(100vh-12rem)] overflow-y-auto pr-4" aria-label={t(locale, 'docs.nav_label')}>
        {nav.map((g) => (
          <div class="mb-6">
            <p class="mb-2 font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-faint">
              {t(locale, g.labelKey)}
            </p>
            <ul class="space-y-0.5 border-l border-line">
              {g.items.map((i) => (
                <li>
                  <a
                    href={localePath(locale, `docs/${i.slug}`)}
                    class:list={[
                      '-ml-px block border-l-2 py-1 pl-4 text-sm',
                      i.slug === slug
                        ? 'border-fg font-medium text-fg'
                        : 'border-transparent text-muted hover:text-fg',
                    ]}
                  >
                    {i.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        </nav>
      </div>
    </aside>

    <!-- Mobile docs menu -->
    <details class="rounded-lg border border-line bg-surface lg:hidden">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-muted">
        {t(locale, 'docs.menu')}
      </summary>
      <nav class="border-t border-line px-4 py-3">
        {nav.map((g) => (
          <div class="mb-3">
            <p class="mb-1 font-mono text-[10px] uppercase tracking-wider text-faint">{t(locale, g.labelKey)}</p>
            {g.items.map((i) => (
              <a
                href={localePath(locale, `docs/${i.slug}`)}
                class:list={['block py-1 text-sm', i.slug === slug ? 'text-fg' : 'text-muted']}
              >
                {i.title}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </details>

    <!-- Body -->
    <article class="min-w-0">
      <nav class="mb-6 flex items-center font-mono text-xs text-faint" aria-label={t(locale, 'docs.breadcrumb')}>
        <a href={localePath(locale, 'docs')} class="hover:text-fg">{t(locale, 'nav.docs')}</a>
        <span class="mx-2">/</span>
        <span class="text-muted">{entry.data.title}</span>
        <span class="ml-auto flex items-center gap-3">
          <a href={`/docs/${slug}.md`} class="underline decoration-line underline-offset-4 hover:text-fg">
            {t(locale, 'docs.export')}
          </a>
          <a href="/docs/export-all.md" class="underline decoration-line underline-offset-4 hover:text-fg">
            {t(locale, 'docs.export_all')}
          </a>
        </span>
      </nav>
      <h1 class="mb-6 text-4xl font-semibold tracking-tight text-fg">{entry.data.title}</h1>
      <div class="doc-body">
        <Content />
      </div>

      <nav class="mt-14 flex items-center justify-between border-t border-line pt-6" aria-label={t(locale, 'docs.pager')}>
        {prev ? (
          <a href={localePath(locale, `docs/${prev.slug}`)} class="text-sm text-muted hover:text-fg">
            {prev.title}
          </a>
        ) : <span />}
        {next ? (
          <a href={localePath(locale, `docs/${next.slug}`)} class="text-sm text-muted hover:text-fg">
            {next.title}
          </a>
        ) : <span />}
      </nav>
    </article>

    <!-- TOC -->
    <aside class="hidden xl:block">
      <nav class="sticky top-24" aria-label={t(locale, 'docs.toc')}>
        <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-faint">
          {t(locale, 'docs.toc')}
        </p>
        <ul class="space-y-1.5 border-l border-line">
          {toc.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class:list={[
                  '-ml-px block border-l-2 border-transparent py-0.5 text-xs text-muted hover:border-fg hover:text-fg',
                  h.depth === 3 ? 'pl-7' : 'pl-4',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>

  <script define:vars={{ emptyText: t(locale, 'docs.search_empty'), base: locale === 'en' ? '/docs/' : `/${locale}/docs/` }}>
    const input = document.getElementById('docs-search');
    const results = document.getElementById('docs-results');
    let index = null;

    async function ensureIndex() {
      if (index) return index;
      const res = await fetch('/api/docs-index.json');
      index = res.ok ? await res.json() : [];
      return index;
    }

    function esc(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    input?.addEventListener('input', async () => {
      const q = input?.value.trim().toLowerCase() ?? '';
      if (!q || !results) {
        results?.classList.add('hidden');
        return;
      }
      const idx = await ensureIndex();
      const terms = q.split(/\s+/);
      const hits = idx
        .map((d) => {
          const hay = `${d.title} ${d.text}`.toLowerCase();
          const score = terms.reduce((acc, term) => acc + (hay.includes(term) ? 1 : 0) + (d.title.toLowerCase().includes(term) ? 2 : 0), 0);
          return { d, score };
        })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);
      results.innerHTML = hits.length
        ? hits
            .map((x) => `<li><a href="${base}${esc(x.d.slug)}" class="block rounded-md px-3 py-1.5 text-sm text-muted hover:bg-raised hover:text-fg">${esc(x.d.title)}</a></li>`)
            .join('')
        : `<li class="px-3 py-1.5 text-sm text-faint">${esc(emptyText)}</li>`;
      results.classList.remove('hidden');
    });

    document.addEventListener('click', (e) => {
      if (results && input && !results.contains(e.target) && e.target !== input) {
        results.classList.add('hidden');
      }
    });
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') results?.classList.add('hidden');
    });
  </script>
</Base>

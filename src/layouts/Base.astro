---
import '../styles/global.css';
import fontGrotesk from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import Starfield from '../components/Starfield.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, OG_LOCALES, PREFIXED_LOCALES, type Locale } from '../config/site';
import { t, localePath } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogCard?: string | undefined;
  path?: string | undefined;
  preloadImg?: string | undefined;
  preloadSrcset?: string | undefined;
  preloadImgLight?: string | undefined;
  preloadSrcsetLight?: string | undefined;
}

const { locale, title, description, ogCard = 'card', path, preloadImg, preloadSrcset, preloadImgLight, preloadSrcsetLight } = Astro.props;
const canonical = new URL(localePath(locale, path ?? ''), SITE.domain).href;
const ogImage = `${SITE.domain}/og/${ogCard}.webp`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={fontGrotesk} as="font" type="font/woff2" crossorigin />
    {preloadImg && (
      <link
        rel="preload"
        href={preloadImg}
        as="image"
        type="image/webp"
        fetchpriority="high"
        media="(prefers-color-scheme: dark)"
        imagesrcset={preloadSrcset}
        imagesizes={preloadSrcset ? '(min-width: 64rem) 720px, 92vw' : undefined}
      />
    )}
    {preloadImgLight && (
      <link
        rel="preload"
        href={preloadImgLight}
        as="image"
        type="image/webp"
        fetchpriority="high"
        media="(prefers-color-scheme: light)"
        imagesrcset={preloadSrcsetLight}
        imagesizes={preloadSrcsetLight ? '(min-width: 64rem) 720px, 92vw' : undefined}
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MeshChatX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MeshChatX logo" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {PREFIXED_LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localePath(l, path ?? ''), SITE.domain).href} />
    ))}
    <link rel="alternate" hreflang="en" href={new URL(localePath('en', path ?? ''), SITE.domain).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path ?? ''), SITE.domain).href} />
    <link rel="alternate" href="/legacy" title="Legacy" />
    <link rel="alternate" type="application/rss+xml" title="MeshChatX News" href="/news.xml" />
    <noscript>
      <meta http-equiv="refresh" content="0;url=/legacy" />
    </noscript>

    <script is:inline>
      (function () {
        var skip =
          (location.search || '').indexOf('noredirect=1') !== -1 ||
          (location.pathname || '').indexOf('/legacy') === 0;
        if (!skip) {
          try {
            var ie = typeof document.documentMode === 'number';
            var noFetch = typeof fetch === 'undefined';
            var noPromise = typeof Promise === 'undefined';
            var noFlex = typeof CSS === 'undefined' || !CSS.supports || !CSS.supports('display', 'flex');
            if (ie || noFetch || noPromise || noFlex) {
              location.replace('/legacy');
              return;
            }
          } catch (e) {
            location.replace('/legacy');
            return;
          }
        }
        var theme = '';
        try {
          theme = localStorage.getItem('mcx-theme') || '';
        } catch (err) {}
        if (!theme) {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
        try {
          var raw = localStorage.getItem('mcx-donate-banner');
          var year = 365 * 24 * 60 * 60 * 1000;
          var ts = 0;
          if (raw === '1') {
            ts = Date.now();
            localStorage.setItem('mcx-donate-banner', String(ts));
          } else if (raw) {
            ts = parseInt(raw, 10) || 0;
          }
          if (ts && Date.now() - ts < year) {
            document.documentElement.dataset.donateBanner = 'hide';
          }
        } catch (err) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'MeshChatX',
      applicationCategory: 'CommunicationApplication',
      operatingSystem: 'Windows, macOS, Linux, Android',
      description: t(locale, 'meta.desc.home'),
      url: SITE.domain,
      downloadUrl: `${SITE.domain}/download`,
      license: `${SITE.domain}/license`,
      codeRepository: SITE.githubUrl,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Organization', name: 'Quad4', url: SITE.quad4Url },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'MeshChatX',
      url: SITE.domain,
    })} />
  </head>
  <body class="min-h-screen">
    <noscript>
      <p><a href="/legacy">Legacy / text-only site</a></p>
    </noscript>
    <Starfield />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-fg"
      >{t(locale, 'a11y.skip')}</a
    >
    <Nav locale={locale} />
    <main id="main" class="relative">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        let refreshing = false;
        const hadController = !!navigator.serviceWorker.controller;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          // only reload when an existing SW is replaced, not on first install
          if (!hadController || refreshing) return;
          refreshing = true;
          location.reload();
        });
        window.addEventListener('load', () => {
          const idle = window.requestIdleCallback || ((fn) => setTimeout(fn, 1));
          idle(() => navigator.serviceWorker
            .register('/sw.js')
            .then((reg) => {
              if (reg.waiting) reg.waiting.postMessage('skip');
              reg.addEventListener('updatefound', () => {
                const sw = reg.installing;
                sw?.addEventListener('statechange', () => {
                  if (sw.state === 'installed' && navigator.serviceWorker.controller) {
                    sw.postMessage('skip');
                  }
                });
              });
              const update = () => {
                if (navigator.onLine) reg.update().catch(() => {});
              };
              window.addEventListener('online', update);
              setInterval(update, 3600000);
            })
            .catch(() => {}));
        });
      }
    </script>
    <script is:inline>
      (function () {
        var apply = function () {
          var light = document.documentElement.dataset.theme === 'light';
          document.querySelectorAll('img[data-theme-dark][data-theme-light]').forEach(function (img) {
            var src = light ? img.getAttribute('data-theme-light') : img.getAttribute('data-theme-dark');
            var ss = light ? img.getAttribute('data-srcset-light') : img.getAttribute('data-srcset-dark');
            if (src) img.setAttribute('src', src);
            if (ss) img.setAttribute('srcset', ss);
            var source = img.parentElement && img.parentElement.querySelector('source');
            if (source) source.media = light ? 'all' : 'not all';
          });
        };
        var osLight = matchMedia('(prefers-color-scheme: light)').matches;
        var themedLight = document.documentElement.dataset.theme === 'light';
        if (themedLight !== osLight) apply();
        new MutationObserver(apply).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>
  </body>
</html>

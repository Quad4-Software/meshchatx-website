# GitHub releases fetch at build time. Raises the rate limit 60 -> 5000/hr.
# GITHUB_TOKEN=

# Permit a build with zero releases (download page/API would be hollow).
# MCX_ALLOW_EMPTY_RELEASES=1

# Sibling checkout of the app repo, for docs git stamps. Defaults to
# ../../<repo-name-from-site.json>.
# MCX_APP_REPO=

# jsDelivr-style mirror base for repo-committed public/ assets in the edge
# wasm build. Defaults to cdn.jsdelivr.net/gh/<siteRepo from site.json>.
# MCX_CDN_MIRROR=

# Gcore FastEdge deploy (scripts/deploy-fastedge.sh)
GCORE_API_KEY=
GCORE_APP_ID=

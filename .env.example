# GitHub releases fetch at build time. Raises the rate limit 60 -> 5000/hr.
# GITHUB_TOKEN=

# Bunny Storage. When the AccessKey is set, download links prefer
# BUNNY_CDN_BASE/<track>/<tag>/<file> for objects that exist on the zone.
BUNNY_STORAGE_ZONE=quad4
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_ENDPOINT=https://ny.storage.bunnycdn.com
BUNNY_CDN_BASE=https://cdn.quad4.io

# Gcore FastEdge deploy (scripts/deploy-fastedge.sh)
GCORE_API_KEY=
GCORE_APP_ID=

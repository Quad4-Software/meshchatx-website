# GitHub metadata for the download page
# GITHUB_TOKEN=

# Bunny Storage. When the AccessKey is set, download links prefer
# CDN_BASE/<track>/<tag>/<file> for objects that exist on the zone.
BUNNY_STORAGE_ZONE=quad4
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_ENDPOINT=https://ny.storage.bunnycdn.com
BUNNY_CDN_BASE=https://cdn.quad4.io

# Local compose (docker compose up)
HTTP_PORT=8080
API_PORT=8090
CDN_BASE=https://cdn.quad4.io
